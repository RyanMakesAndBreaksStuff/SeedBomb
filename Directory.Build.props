<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Audit at moderate+ but do not block the build for high-severity transitive
         vulnerabilities in the Dataverse SDK (System.Security.Cryptography.Xml 8.0.2).
         NU1903 = high severity. Warning is still emitted; only error promotion is suppressed.
         Revisit when Microsoft.PowerPlatform.Dataverse.Client ships an updated dep. -->
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>
  <!-- Test projects do not require XML doc comments on every public member -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>