<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Central CVE pin for the Dataverse SDK's transitive System.Security.Cryptography.Xml 8.0.2.
         net10.0 only: on net10.0-windows the Windows Desktop framework already ships a serviced
         copy, and referencing 10.x there fails restore with NU1510. -->
    <GlobalPackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10"
                            Condition="!$(TargetFramework.Contains('-windows'))" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dataverse (targets net8.0, forward-compatible with net10.0) -->
    <PackageVersion Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
    <!-- WPF Desktop -->
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.90.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.90.0" />
    <PackageVersion Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <!-- Data Generation -->
    <PackageVersion Include="Bogus" Version="[35.6.5]" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.0.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <!-- Caching -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <!-- In-memory Dataverse simulation engine for integration tests (targets net8.0; runs on net10 via compat) -->
    <PackageVersion Include="XrmMockup365" Version="1.18.0" />
  </ItemGroup>
</Project>
