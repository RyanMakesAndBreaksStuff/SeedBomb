<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Central CVE pin for the Dataverse SDK's transitive System.Security.Cryptography.Xml.
         Applied to every project centrally so SeedBomb.Core/SeedBomb.Bulk do not need a
         direct PackageReference; NuGet emits NU1603 if only the transitive 8.0.2 resolves. -->
    <GlobalPackageReference Include="System.Security.Cryptography.Xml" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dataverse (targets net8.0, forward-compatible with net10.0) -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Identity.Web.MicrosoftGraph" Version="4.15.0" />
    <PackageVersion Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
    <!-- WPF Desktop -->
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.90.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.90.0" />
    <PackageVersion Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <!-- Identity -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.15.0" />
    <PackageVersion Include="Microsoft.Identity.Web.UI" Version="4.15.0" />
    <PackageVersion Include="Microsoft.Identity.Web.Azure" Version="4.15.0" />
    <PackageVersion Include="Microsoft.Identity.Web.TokenCache" Version="[4.2.0, 5.0.0)" />
    <!-- UI -->
    <PackageVersion Include="MudBlazor" Version="9.8.0" />
    <!-- Data Generation -->
    <PackageVersion Include="Bogus" Version="[35.6.5]" />
    <!-- Testing -->
    <PackageVersion Include="AngleSharp" Version="1.8.0-beta.603" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="coverlet.MTP" Version="10.0.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="bunit" Version="2.9.0" />
    <!-- Caching -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <!-- In-memory Dataverse simulation engine for integration tests (targets net8.0; runs on net10 via compat) -->
    <PackageVersion Include="XrmMockup365" Version="1.18.0" />
  </ItemGroup>
</Project>