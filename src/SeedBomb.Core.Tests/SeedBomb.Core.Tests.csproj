<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- Test methods don't require XML doc comments -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SeedBomb.Core/SeedBomb.Core.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Moq" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Update="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="System.Security.Cryptography.Xml">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
