@if (Entities.Count > 0)
{
    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Record counts per entity</MudText>
    <MudGrid>
        @foreach (var entity in Entities)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudNumericField T="int"
                                 @bind-Value="_counts[entity.LogicalName]"
                                 Label="@entity.DisplayName"
                                 Min="1"
                                 Max="100000"
                                 Variant="Variant.Outlined" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    /// <summary>The selected entities for which to configure record counts.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<EntitySummary> Entities { get; set; } = [];

    private readonly Dictionary<string, int> _counts = [];

    /// <summary>Returns the configured record count per entity logical name.</summary>
    public IReadOnlyDictionary<string, int> GetCounts() => _counts;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        foreach (var entity in Entities)
            _counts.TryAdd(entity.LogicalName, 10);

        var current = Entities.Select(e => e.LogicalName).ToHashSet();
        foreach (var key in _counts.Keys.Except(current).ToList())
            _counts.Remove(key);
    }
}
