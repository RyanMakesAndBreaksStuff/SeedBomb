@if (Progress is not null)
{
    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1">@Progress.Phase</MudText>

        @if (!string.IsNullOrEmpty(Progress.EntityName))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Progress.EntityName</MudText>
        }

        <MudProgressLinear Value="@_progressPercent" Rounded="true" Size="Size.Medium" Color="Color.Primary" />

        <MudStack Row="true" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.caption">
                @Progress.RecordsCreated.ToString("N0") / @Progress.TotalRecords.ToString("N0") records
            </MudText>
            @if (Progress.RecordsPerMinute > 0)
            {
                <MudText Typo="Typo.caption">@Progress.RecordsPerMinute.ToString("N0") rec/min</MudText>
            }
            <MudText Typo="Typo.caption">
                @($"{(int)Progress.Elapsed.TotalMinutes:00}:{Progress.Elapsed.Seconds:00}")
            </MudText>
        </MudStack>

        @if (Progress.TotalBatches > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                Batch @Progress.BatchesCompleted / @Progress.TotalBatches
            </MudText>
        }
    </MudStack>
}

@code {
    /// <summary>Current progress snapshot pushed from the generation pipeline.</summary>
    [Parameter] public ProgressUpdate? Progress { get; set; }

    private int _progressPercent =>
        Progress is { TotalRecords: > 0 }
            ? (int)((double)Progress.RecordsCreated / Progress.TotalRecords * 100)
            : 0;
}
