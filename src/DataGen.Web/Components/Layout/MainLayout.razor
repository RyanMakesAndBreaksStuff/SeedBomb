@inherits LayoutComponentBase

<MudLayout>
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-3">DataGen</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mr-2">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                               Href="/MicrosoftIdentity/Account/SignOut?post_logout_redirect_uri=/"
                               Color="Color.Inherit" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
