@page "/app"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable

@inject GenerationService GenerationService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ILogger<Home> Logger

<PageTitle>Dataverse Data Seeder</PageTitle>

<div class="home-grid">

    <!-- ── Left column: steps ── -->
    <div class="home-main">

        <!-- 01 — Entities -->
        <div class="ds-card">
            <div class="step-header">
                <div class="step-num">01</div>
                <span class="step-title">SELECT ENTITIES</span>
            </div>
            <EntitySelector @ref="_entitySelector" SelectedEntitiesChanged="OnEntitiesChanged" />
        </div>

        <!-- 02 — Configure -->
        <div class="ds-card">
            <div class="step-header">
                <div class="step-num">02</div>
                <span class="step-title">CONFIGURE</span>
            </div>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int"
                                     @bind-Value="_seed"
                                     Label="Seed"
                                     Min="0"
                                     Variant="Variant.Outlined"
                                     HelperText="Same seed → reproducible data" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int"
                                     @bind-Value="_batchSize"
                                     Label="Batch size"
                                     Min="1"
                                     Max="1000"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?"
                                     @bind-Value="_maxParallelism"
                                     Label="Max parallelism"
                                     Min="1"
                                     Max="32"
                                     Variant="Variant.Outlined"
                                     HelperText="Leave blank for auto" />
                </MudItem>
            </MudGrid>
            <FieldOverrides @ref="_fieldOverrides" Entities="_selectedEntities" />
        </div>

        <!-- 03 — Execute -->
        <div class="ds-card @(_isGenerating ? "generating-active" : "")">
            <div class="step-header">
                <div class="step-num">03</div>
                <span class="step-title">EXECUTE</span>
            </div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="OnGenerateAsync"
                           Disabled="@(_isGenerating || !_selectedEntities.Any())"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Style="min-width: 220px; height: 48px;">
                    @(_isGenerating ? "GENERATING..." : "GENERATE DATA")
                </MudButton>
                @if (_isGenerating)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               OnClick="OnCancel"
                               Disabled="@_isCancelling"
                               StartIcon="@Icons.Material.Filled.Stop"
                               Style="height: 48px;">
                        @(_isCancelling ? "ABORTING..." : "ABORT")
                    </MudButton>
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                }
            </MudStack>
        </div>

    </div>

    <!-- ── Right column: live status ── -->
    <div class="home-side">

        @if (_isGenerating || _progress is not null)
        {
            <div class="ds-card @(_isGenerating ? "ds-card-accent" : "")">
                <div class="step-header">
                    <div class="side-indicator @(_isGenerating ? "indicator-active" : "indicator-done")"></div>
                    <span class="step-title">@(_isGenerating ? "ACTIVE" : "COMPLETE")</span>
                </div>
                <ProgressMonitor Progress="_progress" />
            </div>
        }

        @if (_result is not null)
        {
            <div class="ds-card ds-card-accent">
                <div class="result-count">@_result.TotalRecords.ToString("N0")</div>
                <div class="result-label">RECORDS CREATED</div>
                <div class="result-time">in @($"{(int)_result.Elapsed.TotalMinutes:00}:{_result.Elapsed.Seconds:00}")</div>
                @if (_result.Errors.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                        @_result.Errors.Count batch error(s) — details below, full trace in server logs
                    </MudAlert>
                    <MudSimpleTable Dense="true" Class="mt-2"
                                    Style="font-size:.75rem; max-height:200px; overflow-y:auto;">
                        <thead>
                            <tr>
                                <th>Entity</th>
                                <th>Batch</th>
                                <th>Error</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var err in _result.Errors.Take(10))
                            {
                                <tr>
                                    <td>@err.EntityLogicalName</td>
                                    <td>@err.BatchIndex</td>
                                    <td style="max-width:340px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                        @err.ErrorMessage
                                    </td>
                                </tr>
                            }
                            @if (_result.Errors.Count > 10)
                            {
                                <tr>
                                    <td colspan="3" style="color:#888;font-style:italic">
                                        … @(_result.Errors.Count - 10) more — check server logs
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </div>
        }

        @if (_selectedEntities.Any() && !_isGenerating && _result is null)
        {
            <div class="ds-card ds-card-dim">
                <div class="step-header" style="margin-bottom: 14px;">
                    <span class="step-title">QUEUED</span>
                    <MudSpacer />
                    <span style="font-family: 'JetBrains Mono', monospace; font-size: .7rem; color: #3A7848;">
                        @_selectedEntities.Count entities
                    </span>
                </div>
                @foreach (var e in _selectedEntities.Take(9))
                {
                    <div class="queue-item">
                        <div class="queue-dot"></div>
                        <span class="queue-name">@e.DisplayName</span>
                    </div>
                }
                @if (_selectedEntities.Count > 9)
                {
                    <div class="queue-more">+@(_selectedEntities.Count - 9) more</div>
                }
            </div>
        }

        @if (!_selectedEntities.Any() && !_isGenerating && _result is null)
        {
            <div class="ds-card ds-card-dim" style="text-align: center; padding: 40px 24px;">
                <MudIcon Icon="@Icons.Material.Outlined.DataArray"
                         Style="font-size: 2.4rem; color: #181E2E; display: block; margin: 0 auto 14px;" />
                <div style="font-family: 'Syncopate', sans-serif; font-size: .58rem; letter-spacing: .18em; color: #181E2E;">
                    SELECT ENTITIES TO BEGIN
                </div>
            </div>
        }

    </div>
</div>

@code {
    private EntitySelector? _entitySelector;
    private FieldOverrides? _fieldOverrides;

    private IReadOnlyList<EntitySummary> _selectedEntities = [];
    private ProgressUpdate? _progress;
    private GenerationResult? _result;
    private bool _isGenerating;
    private bool _isCancelling;
    private CancellationTokenSource? _cts;
    private Task<GenerationResult>? _generationTask;

    private int _seed = 42;
    private int _batchSize = 500;
    private int? _maxParallelism;

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        if (_generationTask is not null)
        {
            try
            {
                await _generationTask.WaitAsync(TimeSpan.FromSeconds(10), CancellationToken.None);
            }
            catch (TimeoutException)
            {
                Logger.LogWarning("Generation task did not drain within 10s during disposal; allowing background completion.");
            }
        }
        _cts?.Dispose();
    }

    private void OnEntitiesChanged(IReadOnlyList<EntitySummary> entities)
    {
        if (_isGenerating) return;
        _selectedEntities = entities;
        _result = null;
        _progress = null;
    }

    private async Task OnGenerateAsync()
    {
        if (!_selectedEntities.Any()) return;

        _isGenerating = true;
        _progress = null;
        _result = null;
        _cts = new CancellationTokenSource();

        var rawCounts = _fieldOverrides?.GetCounts() ?? new Dictionary<string, int>();
        var counts = _selectedEntities.ToDictionary(
            e => e.LogicalName,
            e => rawCounts.TryGetValue(e.LogicalName, out var c) ? c : 10);

        var config = new GenerationConfig
        {
            EntityLogicalNames = [.. _selectedEntities.Select(e => e.LogicalName)],
            RecordCounts = counts,
            Seed = _seed,
            BatchSize = _batchSize,
            MaxParallelism = _maxParallelism,
        };

        var progress = new Progress<ProgressUpdate>(update =>
        {
            InvokeAsync(() =>
            {
                _progress = update;
                StateHasChanged();
            });
        });

        try
        {
            _generationTask = GenerationService.GenerateAsync(config, progress, _cts.Token);
            _result = await _generationTask;
            Snackbar.Add($"Created {_result.TotalRecords:N0} records", Severity.Success);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Generation cancelled", Severity.Warning);
        }
        catch (Microsoft.Identity.Client.MsalUiRequiredException ex)
        {
            var classification = ex.Classification.ToString();
            if (ex.Classification is Microsoft.Identity.Client.UiRequiredExceptionClassification.BasicAction or Microsoft.Identity.Client.UiRequiredExceptionClassification.AdditionalAction)
            {
                Snackbar.Add("Session expired — please sign in again", Severity.Warning);
                Navigation.NavigateTo("/MicrosoftIdentity/Account/SignIn", forceLoad: true);
            }
            else
            {
                Snackbar.Add($"Generation failed (ref {System.Diagnostics.Activity.Current?.Id ?? "n/a"}; {classification})", Severity.Error);
            }
        }
        catch (Microsoft.Identity.Web.MicrosoftIdentityWebChallengeUserException)
        {
            Snackbar.Add("Session expired — please sign in again", Severity.Warning);
            Navigation.NavigateTo("/MicrosoftIdentity/Account/SignIn", forceLoad: true);
        }
        catch (Exception ex)
        {
            if (ex.GetBaseException() is Microsoft.Identity.Client.MsalUiRequiredException or Microsoft.Identity.Web.MicrosoftIdentityWebChallengeUserException)
            {
                Snackbar.Add("Session expired — please sign in again", Severity.Warning);
                Navigation.NavigateTo("/MicrosoftIdentity/Account/SignIn", forceLoad: true);
            }
            else
            {
                Snackbar.Add($"Generation failed (ref {System.Diagnostics.Activity.Current?.Id ?? "n/a"})", Severity.Error);
            }
        }
        finally
        {
            _isGenerating = false;
            _isCancelling = false;
            _cts?.Dispose();
            _cts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnCancel()
    {
        _isCancelling = true;
        _cts?.Cancel();
        InvokeAsync(StateHasChanged);
    }
}
