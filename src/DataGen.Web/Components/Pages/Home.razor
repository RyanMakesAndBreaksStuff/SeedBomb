@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

@inject GenerationService GenerationService
@inject ISnackbar Snackbar

<PageTitle>DataGen</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Synthetic Data Generator</MudText>
<MudDivider Class="mb-6" />

<MudGrid>
    <MudItem xs="12" md="8">

        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-3">1 — Select entities</MudText>
            <EntitySelector @ref="_entitySelector" SelectedEntitiesChanged="OnEntitiesChanged" />
        </MudPaper>

        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-3">2 — Configure generation</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int"
                                     @bind-Value="_seed"
                                     Label="Seed"
                                     Min="0"
                                     Variant="Variant.Outlined"
                                     HelperText="Same seed → reproducible data" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int"
                                     @bind-Value="_batchSize"
                                     Label="Batch size"
                                     Min="1"
                                     Max="1000"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?"
                                     @bind-Value="_maxParallelism"
                                     Label="Max parallelism"
                                     Min="1"
                                     Max="32"
                                     Variant="Variant.Outlined"
                                     HelperText="Leave blank for auto" />
                </MudItem>
            </MudGrid>
            <FieldOverrides @ref="_fieldOverrides" Entities="_selectedEntities" />
        </MudPaper>

        <MudPaper Class="pa-4 mt-4" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-3">3 — Generate</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           OnClick="OnGenerateAsync"
                           Disabled="@(_isGenerating || !_selectedEntities.Any())"
                           StartIcon="@Icons.Material.Filled.PlayArrow">
                    @(_isGenerating ? "Generating…" : "Generate")
                </MudButton>
                @if (_isGenerating)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               OnClick="OnCancel"
                               StartIcon="@Icons.Material.Filled.Stop">
                        Cancel
                    </MudButton>
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
            </MudStack>
        </MudPaper>

    </MudItem>

    <MudItem xs="12" md="4">
        @if (_isGenerating || _progress is not null)
        {
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Progress</MudText>
                <ProgressMonitor Progress="_progress" />
            </MudPaper>
        }

        @if (_result is not null)
        {
            <MudPaper Class="pa-4 mt-4" Outlined="true">
                <MudAlert Severity="Severity.Success" Dense="true">
                    @_result.TotalRecords.ToString("N0") records created
                    in @($"{(int)_result.Elapsed.TotalMinutes:00}:{_result.Elapsed.Seconds:00}")
                </MudAlert>
                @if (_result.Errors.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                        @_result.Errors.Count batch error(s) — check logs
                    </MudAlert>
                }
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private EntitySelector? _entitySelector;
    private FieldOverrides? _fieldOverrides;

    private IReadOnlyList<EntitySummary> _selectedEntities = [];
    private ProgressUpdate? _progress;
    private GenerationResult? _result;
    private bool _isGenerating;
    private CancellationTokenSource? _cts;

    private int _seed = 42;
    private int _batchSize = 500;
    private int? _maxParallelism;

    private readonly string _sessionId = Guid.NewGuid().ToString("N");

    private void OnEntitiesChanged(IReadOnlyList<EntitySummary> entities)
    {
        _selectedEntities = entities;
        _result = null;
    }

    private async Task OnGenerateAsync()
    {
        if (!_selectedEntities.Any()) return;

        _isGenerating = true;
        _progress = null;
        _result = null;
        _cts = new CancellationTokenSource();

        var counts = _fieldOverrides?.GetCounts()
            ?? _selectedEntities.ToDictionary(e => e.LogicalName, _ => 10);

        var config = new GenerationConfig
        {
            EntityLogicalNames = [.. _selectedEntities.Select(e => e.LogicalName)],
            RecordCounts = counts.ToDictionary(kv => kv.Key, kv => kv.Value),
            Seed = _seed,
            BatchSize = _batchSize,
            MaxParallelism = _maxParallelism,
        };

        var progress = new Progress<ProgressUpdate>(update =>
        {
            _progress = update;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            _result = await GenerationService.GenerateAsync(config, _sessionId, progress, _cts.Token);
            Snackbar.Add($"Created {_result.TotalRecords:N0} records", Severity.Success);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Generation cancelled", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGenerating = false;
            _cts?.Dispose();
            _cts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnCancel() => _cts?.Cancel();
}
