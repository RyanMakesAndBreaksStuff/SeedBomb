<!--
    Shell — replaces Views/Windows/MainWindow.xaml.
    Nav order and geometry from 1a. All values via DynamicResource DG.*; no literals.
-->
<ui:FluentWindow x:Class="SeedBomb.Views.Windows.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:SeedBomb.Views.Pages"
                 Title="SeedBomb — Mock data explosion"
                 Width="1100" Height="800" MinWidth="960" MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Icon="pack://application:,,,/Resources/logo.ico">

    <!-- Canvas lives here, not on Window.Background: WPF-UI assigns the window a local fallback
         brush on startup and on every theme switch, which would drop a DynamicResource. -->
    <Grid Background="{DynamicResource DG.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105*" />
            <ColumnDefinition Width="94*" />
            <ColumnDefinition Width="981*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="171*" />
            <RowDefinition Height="553*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Height="{DynamicResource DG.Size.TitleBar}"
            Background="{DynamicResource DG.TitleBar}"
            Title="SeedBomb — Mock data explosion"
            ShowMaximize="True" ShowMinimize="True" VerticalAlignment="Center" Grid.ColumnSpan="3">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/logo.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--
            NavigationView owns the 260px pane. Footer holds Settings, and the account block
            sits below the footer as PaneFooter content so it pins to the bottom of the pane.
        -->
        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1" Grid.Column="0"
                           OpenPaneLength="{DynamicResource DG.Size.NavPane}"
                           IsPaneToggleVisible="True"
                           IsBackButtonVisible="Collapsed"
                           PaneDisplayMode="Left"
                           FrameMargin="0"
                           Background="{DynamicResource DG.Surface1}" Grid.RowSpan="2" Grid.ColumnSpan="3">

            <ui:NavigationView.MenuItems>
                <!-- Dimmed, not disabled: IsEnabled still gates on HasConnection alone (zero profiles).
                     Do not set Style — a local Style replaces WPF-UI's implicit NavigationViewItem chrome,
                     and that chrome is not a designer-visible resource to BasedOn. -->
                <ui:NavigationViewItem Content="Generate"
                                       TargetPageType="{x:Type pages:GeneratePage}"
                                       IsEnabled="{Binding HasConnection}"
                                       Opacity="{Binding ConnectedOpacity}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Flash24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Profiles"
                                       TargetPageType="{x:Type pages:ProfilesPage}"
                                       IsEnabled="{Binding HasConnection}"
                                       Opacity="{Binding ConnectedOpacity}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Layer24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="History"
                                       TargetPageType="{x:Type pages:HistoryPage}"
                                       IsEnabled="{Binding HasConnection}"
                                       Opacity="{Binding ConnectedOpacity}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="History24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <!--
                    Connections is config, so it sits with Settings rather than in MenuItems.
                    The account block below is a shortcut to the same page, not the only route.
                -->
                <ui:NavigationViewItem Content="Connections"
                                       TargetPageType="{x:Type pages:ConnectionsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="Settings"
                                       TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="About"
                                       TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- Account + environment. Click opens the connection manager. -->
            <ui:NavigationView.PaneFooter>
                <Button Style="{StaticResource DG.LinkButton}"
                        Opacity="{Binding ConnectedOpacity}"
                        Command="{Binding OpenConnectionsCommand}"
                        HorizontalContentAlignment="Stretch"
                        Margin="8,8,8,12">
                    <Border BorderBrush="{DynamicResource DG.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="4,10,4,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                    Background="{DynamicResource DG.Accent}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding UserInitials}"
                                           FontSize="{DynamicResource DG.Type.Micro}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DG.OnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserDisplayName}"
                                           FontSize="{DynamicResource DG.Type.Caption}"
                                           Foreground="{DynamicResource DG.TextNav}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding EnvironmentHost}"
                                           FontSize="{DynamicResource DG.Type.Label}"
                                           Foreground="{DynamicResource DG.Text3}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>

        <!-- Snackbar host sits above the frame so run notifications float over any page. Centered
             over the content column via alignment (not a fixed pixel offset) so it stays put
             when the window is resized. -->
        <ui:SnackbarPresenter Grid.Row="2" x:Name="SnackbarPresenter"
                              VerticalAlignment="Bottom" HorizontalAlignment="Center"
                              Margin="{DynamicResource DG.Pad.Page}" Grid.Column="2" />

        <ui:ContentDialogHost Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3" />

        <Border x:Name="FirstRunOverlay" Grid.Row="1" Grid.Column="0" Style="{DynamicResource DG.Scrim.Style}"
                Visibility="{Binding HasConnection, Converter={StaticResource InverseBoolToVisible}}" Grid.RowSpan="2"
                Grid.ColumnSpan="3">
            <Border Style="{DynamicResource DG.Sheet}" Width="{DynamicResource DG.Size.SheetWidth}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                <StackPanel>
                    <TextBlock Style="{DynamicResource DG.PageTitle}" Text="Connect an environment" />
                    <TextBlock Style="{DynamicResource DG.PageSubtitle}"
                               Text="SeedBomb needs a Dataverse connection before it can generate data." />
                    <Button Style="{DynamicResource DG.PrimaryButton}" Margin="0,20,0,0"
                            Command="{Binding OpenConnectionsCommand}" Content="Add connection" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Shown when a connection profile exists but the startup silent sign-in failed
             (e.g. an OAuth token needing re-consent). App-only profiles never hit this —
             their silent sign-in needs no user/window and always succeeds at startup. -->
        <Border x:Name="SignInOverlay" Grid.Row="1" Grid.Column="0" Style="{DynamicResource DG.Scrim.Style}"
                Visibility="{Binding ShowSignInOverlay, Converter={StaticResource BoolToVisibilityConverter}}"
                Grid.RowSpan="2" Grid.ColumnSpan="3">
            <Border Style="{DynamicResource DG.Sheet}" Width="{DynamicResource DG.Size.SheetWidth}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
                <StackPanel>
                    <TextBlock Style="{DynamicResource DG.PageTitle}" Text="Sign in to continue" />
                    <TextBlock Style="{DynamicResource DG.PageSubtitle}"
                               Text="SeedBomb couldn't reconnect automatically." />
                    <Button Style="{DynamicResource DG.PrimaryButton}" Margin="0,20,0,0"
                            Command="{Binding SignInCommand}" Content="Sign in" />

                    <!-- Escape hatch: the scrim blocks hit-testing on the nav pane underneath
                         (Background is set, so opacity alone doesn't let clicks through), so
                         without this a profile with a bad URL/credential retries "Sign in"
                         forever with no way to reach Connections and fix or delete it. -->
                    <Button Style="{DynamicResource DG.LinkButton}" Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding OpenConnectionsCommand}" Content="Manage connections" />

                    <!-- Bindings for both properties below are wired up in code-behind, with an
                         explicit Source, against the same ConnectionManagerViewModel instance
                         ConnectionsPage's identical banner reads — one shared error. Not declared
                         here as {Binding ...}: that would resolve against the inherited
                         MainWindowViewModel DataContext at parse time (before code-behind can
                         retarget it), logging spurious "property not found" trace errors on every
                         launch even though it's harmless (this banner only ever becomes visible
                         after the retarget has already happened). -->
                    <Border x:Name="SignInErrorBanner" Style="{DynamicResource DG.WarningBanner}"
                            Margin="0,16,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Warning24"
                                           FontSize="{DynamicResource DG.Type.IconLg}"
                                           Foreground="{DynamicResource DG.Warning}"
                                           VerticalAlignment="Center" />
                            <TextBlock x:Name="SignInErrorText" Grid.Column="1" Style="{DynamicResource DG.Secondary}"
                                       Foreground="{DynamicResource DG.WarningText}"
                                       Margin="14,0,0,0" LineHeight="18" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
