<Page x:Class="SeedBomb.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:history="clr-namespace:SeedBomb.Services.History"
      xmlns:vm="clr-namespace:SeedBomb.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
      mc:Ignorable="d"
      VerticalAlignment="Stretch"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource DG.Surface1}">

    <Grid Margin="{DynamicResource DG.Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Style="{DynamicResource DG.PageTitle}" Text="History" />
                <TextBlock Style="{DynamicResource DG.PageSubtitle}" Text="{Binding HistorySummary}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <ui:TextBox PlaceholderText="Search runs"
                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="180"
                            Height="{DynamicResource DG.Size.ControlSmall}"
                            Margin="0,0,8,0"
                            Icon="{ui:SymbolIcon Search24}" />
                <Button Style="{DynamicResource DG.Button}"
                        Command="{Binding ExportCsvCommand}"
                        Content="Export CSV"
                        Height="{DynamicResource DG.Size.ControlSmall}"
                        Margin="0,0,8,0" />
                <Button Style="{DynamicResource DG.DangerButton}"
                        Command="{Binding ClearHistoryCommand}"
                        Content="Clear All"
                        Height="{DynamicResource DG.Size.ControlSmall}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Text="No runs yet — generate some data first."
                       Style="{DynamicResource DG.Secondary}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

            <Border Style="{DynamicResource DG.CardBorder}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisible}}">
                <!-- Header column widths are the source of truth; rows follow via SharedSizeGroup. -->
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <!-- Invisible drag handle straddling a column boundary. -->
                        <Style x:Key="ColumnGrip" TargetType="Thumb">
                            <Setter Property="Width" Value="8" />
                            <Setter Property="Cursor" Value="SizeWE" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Border Grid.Row="0" Style="{DynamicResource DG.TableHeader}">
                        <Grid x:Name="HeaderGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" MinWidth="48" SharedSizeGroup="Time" />
                                <ColumnDefinition x:Name="TablesColumn" Width="*" MinWidth="160" />
                                <ColumnDefinition Width="160" MinWidth="48" SharedSizeGroup="Environment" />
                                <ColumnDefinition Width="150" MinWidth="48" SharedSizeGroup="User" />
                                <ColumnDefinition Width="130" MinWidth="48" SharedSizeGroup="Profile" />
                                <ColumnDefinition Width="88" MinWidth="48" SharedSizeGroup="Records" />
                                <ColumnDefinition Width="72" MinWidth="48" SharedSizeGroup="Duration" />
                                <ColumnDefinition Width="80" MinWidth="48" SharedSizeGroup="Status" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{DynamicResource DG.TableHeaderText}" Text="Time" />
                            <TextBlock Grid.Column="1" Style="{DynamicResource DG.TableHeaderText}" Text="Tables" />
                            <TextBlock Grid.Column="2" Style="{DynamicResource DG.TableHeaderText}" Text="Environment" />
                            <TextBlock Grid.Column="3" Style="{DynamicResource DG.TableHeaderText}" Text="User" />
                            <TextBlock Grid.Column="4" Style="{DynamicResource DG.TableHeaderText}" Text="Profile" />
                            <TextBlock Grid.Column="5" Style="{DynamicResource DG.TableHeaderText}" Text="Records" />
                            <TextBlock Grid.Column="6" Style="{DynamicResource DG.TableHeaderText}" Text="Duration" />
                            <TextBlock Grid.Column="7" Style="{DynamicResource DG.TableHeaderText}" Text="Status" />

                            <!--
                                Tables is the star column, so Time is left-anchored (grip on its right edge) and
                                every column after Tables is right-anchored (grip on its left edge).
                            -->
                            <Thumb Grid.Column="0" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Right"
                                   Margin="0,0,-4,0" DragDelta="OnColumnGripDragDelta" />
                            <Thumb Grid.Column="2" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Margin="-4,0,0,0" DragDelta="OnColumnGripDragDelta" />
                            <Thumb Grid.Column="3" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Margin="-4,0,0,0" DragDelta="OnColumnGripDragDelta" />
                            <Thumb Grid.Column="4" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Margin="-4,0,0,0" DragDelta="OnColumnGripDragDelta" />
                            <Thumb Grid.Column="5" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Margin="-4,0,0,0" DragDelta="OnColumnGripDragDelta" />
                            <Thumb Grid.Column="6" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Margin="-4,0,0,0" DragDelta="OnColumnGripDragDelta" />
                            <Thumb Grid.Column="7" Style="{StaticResource ColumnGrip}" HorizontalAlignment="Left"
                                   Margin="-4,0,0,0" DragDelta="OnColumnGripDragDelta" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding FlatItems}"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                        <ListView.Resources>
                            <DataTemplate DataType="{x:Type vm:HistoryDayHeader}">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}"
                                           Text="{Binding DayLabel}"
                                           Margin="{DynamicResource DG.Pad.Row}" />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type history:RunRecord}">
                                <!-- Transparent (not null) background so the gaps between cells take the click too. -->
                                <Border Style="{DynamicResource DG.TableRow}" Background="Transparent" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenRunCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <!-- No Width: a shared group takes the largest pixel Width, which is the header's. -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="Time" />
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition SharedSizeGroup="Environment" />
                                            <ColumnDefinition SharedSizeGroup="User" />
                                            <ColumnDefinition SharedSizeGroup="Profile" />
                                            <ColumnDefinition SharedSizeGroup="Records" />
                                            <ColumnDefinition SharedSizeGroup="Duration" />
                                            <ColumnDefinition SharedSizeGroup="Status" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{DynamicResource DG.Cell}"
                                                   Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding EntityNames}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{DynamicResource DG.Cell}"
                                                               Text="{Binding}"
                                                               Margin="0,0,8,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="2"
                                                   Style="{DynamicResource DG.Cell}"
                                                   Text="{Binding Environment}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Environment}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3"
                                                   Style="{DynamicResource DG.Cell}"
                                                   Text="{Binding User}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding User}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="4"
                                                   Style="{DynamicResource DG.Cell}"
                                                   Text="{Binding Profile}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Profile}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="5"
                                                   Style="{DynamicResource DG.Cell}"
                                                   Text="{Binding TotalRecords, StringFormat=N0}" />
                                        <TextBlock Grid.Column="6"
                                                   Style="{DynamicResource DG.Cell}"
                                                   Text="{Binding Duration, StringFormat={}{0:mm\\:ss}}" />
                                        <TextBlock Grid.Column="7">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DG.Cell}">
                                                    <Setter Property="Text" Value="Failed" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DG.Error}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                            <Setter Property="Text" Value="Success" />
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource DG.Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.Resources>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>