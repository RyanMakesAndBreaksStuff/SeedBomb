<Page x:Class="SeedBomb.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:SeedBomb.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
      mc:Ignorable="d"
      VerticalAlignment="Stretch"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource DG.Surface1}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="PageHeader" Grid.Row="0" Margin="32,22,32,0">
            <TextBlock Style="{DynamicResource DG.PageTitle}" Text="About" />
            <TextBlock Style="{DynamicResource DG.PageSubtitle}"
                       Text="Application identity, project links, and open-source software" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,0">
            <StackPanel Margin="32,0,32,24" MaxWidth="860">
                <Border Style="{DynamicResource DG.CardBorder}">
                    <Grid Margin="20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="48" Height="48" Margin="0,0,16,0"
                               VerticalAlignment="Top"
                               Source="{DynamicResource DG.Logo}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="SeedBomb logo" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{DynamicResource DG.CardTitle}"
                                       Text="{Binding ProductName}" TextWrapping="Wrap" />
                            <TextBlock Style="{DynamicResource DG.Secondary}" Margin="0,4,0,12"
                                       Text="{Binding Description}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource DG.Tertiary}"
                                           Text="Created by" Margin="0,0,24,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{DynamicResource DG.Cell}"
                                           Text="{Binding Author}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource DG.Tertiary}"
                                           Text="Version" Margin="0,0,24,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{DynamicResource DG.Mono}"
                                           Foreground="{DynamicResource DG.TextBody}"
                                           Text="{Binding Version}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{DynamicResource DG.Tertiary}"
                                           Text="Runtime" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{DynamicResource DG.Mono}"
                                           Foreground="{DynamicResource DG.TextBody}"
                                           Text="{Binding Runtime}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource DG.CardBorder}" Margin="0,14,0,0">
                    <StackPanel Margin="20,18">
                        <TextBlock Style="{DynamicResource DG.CardTitle}" Text="Project" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{DynamicResource DG.LinkButton}" Margin="0,0,18,8"
                                    Content="Source code" Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding SourceCodeUrl}"
                                    ToolTip="Opens in your browser"
                                    AutomationProperties.Name="Source code"
                                    AutomationProperties.HelpText="Opens in your browser" />
                            <Button Style="{DynamicResource DG.LinkButton}" Margin="0,0,18,8"
                                    Content="Documentation" Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding DocumentationUrl}"
                                    ToolTip="Opens in your browser"
                                    AutomationProperties.Name="Documentation"
                                    AutomationProperties.HelpText="Opens in your browser" />
                            <Button Style="{DynamicResource DG.LinkButton}" Margin="0,0,18,8"
                                    Content="Report an issue" Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding IssuesUrl}"
                                    ToolTip="Opens in your browser"
                                    AutomationProperties.Name="Report an issue"
                                    AutomationProperties.HelpText="Opens in your browser" />
                            <Button Style="{DynamicResource DG.Button}" Margin="0,0,0,8"
                                    Content="Application license"
                                    Command="{Binding ShowAppLicenseCommand}"
                                    AutomationProperties.Name="Application license" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource DG.CardBorder}" Margin="0,14,0,0">
                    <StackPanel Margin="20,18">
                        <TextBlock Style="{DynamicResource DG.CardTitle}" Text="Open-source software" />
                        <TextBlock Style="{DynamicResource DG.Tertiary}" Margin="0,4,0,0"
                                   Text="{Binding NoticeError}" TextWrapping="Wrap"
                                   Visibility="{Binding HasNoticeError, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding Featured}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource DG.CardBorder}" Margin="0,0,0,10"
                                            Background="{DynamicResource DG.CardSunken}">
                                        <StackPanel Margin="14,12">
                                            <TextBlock Style="{DynamicResource DG.Body}" FontWeight="SemiBold"
                                                       Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Style="{DynamicResource DG.Secondary}" Margin="0,4,0,0"
                                                       Text="{Binding Credit}" TextWrapping="Wrap"
                                                       Visibility="{Binding Credit, Converter={StaticResource NullToVisibilityConverter}}" />
                                            <TextBlock Style="{DynamicResource DG.Secondary}" Margin="0,4,0,0"
                                                       Text="{Binding Purpose}" TextWrapping="Wrap" />
                                            <TextBlock Style="{DynamicResource DG.Tertiary}" Margin="0,6,0,0"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding Version, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding License, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Copyright, Mode=OneWay}" />
                                            </TextBlock>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Style="{DynamicResource DG.LinkButton}" Margin="0,0,16,0"
                                                        Content="Project"
                                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding ProjectUrl}"
                                                        ToolTip="Opens in your browser"
                                                        AutomationProperties.Name="Open component project"
                                                        AutomationProperties.HelpText="Opens in your browser" />
                                                <Button Style="{DynamicResource DG.Button}"
                                                        Content="View license"
                                                        Command="{Binding DataContext.ShowComponentLicenseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="View component license" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>