<!--
    Connections — 1a moves the connection manager out of a drawer and into a page: a list with
    an inline editor beside it, so adding a connection no longer covers the app.

    Every binding is an existing ConnectionManagerViewModel member: Profiles, SelectedProfile,
    EditingProfile, IsEditing, IsTesting, TestResult, TestSucceeded, IsSwitchingConnection,
    SwitchError, HasSwitchError + the commands.
-->
<Page x:Class="Seedbomb.Views.Pages.ConnectionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conn="clr-namespace:Seedbomb.Services.Connections"
      xmlns:vm="clr-namespace:Seedbomb.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:ConnectionManagerViewModel}"
      mc:Ignorable="d"
      VerticalAlignment="Stretch"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource DG.Surface1}">

    <Grid Margin="{DynamicResource DG.Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Style="{DynamicResource DG.PageTitle}" Text="Connections" />
                <TextBlock Style="{DynamicResource DG.PageSubtitle}"
                           Text="Dataverse environments SeedBomb can write to" />
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource DG.PrimaryButton}"
                    Command="{Binding NewProfileCommand}"
                    VerticalAlignment="Bottom" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Add24" FontSize="{DynamicResource DG.Type.Icon}" Margin="0,0,7,0" />
                    <TextBlock Text="Add connection" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Switch failures surface here, not in a message box. -->
        <Border Grid.Row="1" Style="{DynamicResource DG.WarningBanner}" Margin="0,18,0,0"
                Visibility="{Binding HasSwitchError,
                             Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="{DynamicResource DG.Type.IconLg}"
                               Foreground="{DynamicResource DG.Warning}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{DynamicResource DG.Secondary}"
                           Foreground="{DynamicResource DG.WarningText}"
                           Text="{Binding SwitchError}" Margin="14,0,0,0" LineHeight="18" />
            </Grid>
        </Border>

        <Grid x:Name="BodyGrid" Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <!-- 330 matches DG.Size.ListPane. ColumnDefinition is not a FrameworkElement,
                     so DynamicResource on MaxWidth is unreliable. -->
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- ── Connection list ──────────────────────────────────── -->
            <Border Grid.Column="0" Style="{DynamicResource DG.CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             Background="Transparent" BorderThickness="0" Padding="6"
                             HorizontalContentAlignment="Stretch"
                             IsEnabled="{Binding IsSwitchingConnection,
                                         Converter={StaticResource InverseBoolConverter}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="{DynamicResource DG.Radius.Item}">
                                                <Grid>
                                                    <Border x:Name="Stripe"
                                                            Style="{DynamicResource DG.SelectionStripe}"
                                                            Margin="0,11" Visibility="Collapsed" />
                                                    <ContentPresenter Margin="{DynamicResource DG.Pad.ActionRow}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource DG.ControlHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource DG.RowSelected}" />
                                                    <Setter TargetName="Stripe" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{DynamicResource DG.Cell}"
                                                   Foreground="{DynamicResource DG.Text1}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Name}" />
                                        <TextBlock Style="{DynamicResource DG.Tertiary}"
                                                   Text="{Binding EnvironmentUrl}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <!-- Active connection marker; the nav footer shows the same one.
                                         True only when this row is the profile we're actually
                                         connected to right now, not merely the last-used one. -->
                                    <Border Grid.Column="1" Style="{DynamicResource DG.ChipSelected}"
                                            VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource IdEqualsToVisibilityConverter}">
                                                <Binding Path="Id" />
                                                <Binding Path="DataContext.ConnectedProfileId"
                                                         RelativeSource="{RelativeSource AncestorType=Page}" />
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <TextBlock Text="Active" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource DG.Type.Micro}"
                                                   Foreground="{DynamicResource DG.OnAccent}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="1" Style="{DynamicResource DG.CardFooter}">
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14"
                                         HorizontalAlignment="Left"
                                         Visibility="{Binding IsSwitchingConnection,
                                                      Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Border>
                </Grid>
            </Border>

            <!-- ── Detail / inline editor ───────────────────────────── -->
            <Border Grid.Column="2" Style="{DynamicResource DG.CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource DG.Border}"
                            BorderThickness="0,0,0,1" Padding="{DynamicResource DG.Pad.CardWide}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource DG.CardTitle}"
                                       FontSize="{DynamicResource DG.Type.SheetTitle}"
                                       Text="{Binding EditingProfile.Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{DynamicResource DG.Secondary}"
                                       Text="Sign-in happens in your browser. SeedBomb stores the environment URL and app registration details needed to connect."
                                       Margin="0,4,0,0" LineHeight="18" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,16">
                        <StackPanel IsEnabled="{Binding IsEditing}">
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Display name" />
                                <ui:TextBox Text="{Binding EditingProfile.Name, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="contoso-dev"
                                            FontFamily="{DynamicResource DG.Font.Mono}"
                                            Height="{DynamicResource DG.Size.Control}"
                                            VerticalAlignment="Center" SelectionOpacity="0.5"
                                            VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Environment URL" />
                                <ui:TextBox
                                    Text="{Binding EditingProfile.EnvironmentUrl, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="https://contoso-dev.crm.dynamics.com"
                                    FontFamily="{DynamicResource DG.Font.Mono}"
                                    Height="{DynamicResource DG.Size.Control}" />
                                <TextBlock Style="{DynamicResource DG.Tertiary}"
                                           Foreground="{DynamicResource DG.Error}"
                                           Text="{Binding EnvironmentUrlError}"
                                           Visibility="{Binding EnvironmentUrlError,
                                                        Converter={StaticResource NullToVisibilityConverter}}"
                                           TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Application (client) ID" />
                                <ui:TextBox
                                    Text="{Binding EditingProfile.ClientId, UpdateSourceTrigger=PropertyChanged}"
                                    FontFamily="{DynamicResource DG.Font.Mono}"
                                    Height="{DynamicResource DG.Size.Control}" />
                                <WrapPanel Margin="0,7,0,0">
                                    <TextBlock Style="{DynamicResource DG.Tertiary}"
                                               Text="Blank uses Microsoft's public client for Power Platform."
                                               TextWrapping="Wrap" />
                                    <Button Style="{DynamicResource DG.LinkButton}"
                                            Command="{Binding UseDefaultClientIdCommand}"
                                            Content="Use default" Margin="6,0,0,0" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Tenant ID" />
                                <ui:TextBox
                                    Text="{Binding EditingProfile.TenantId, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="organizations"
                                    FontFamily="{DynamicResource DG.Font.Mono}"
                                    Height="{DynamicResource DG.Size.Control}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Auth type" />
                                <ComboBox SelectedItem="{Binding EditingProfile.AuthType}"
                                          ItemsSource="{Binding Source={x:Static conn:AuthTypeValues.All}}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,14"
                                        Visibility="{Binding EditingProfile.AuthType,
                                                    Converter={StaticResource AuthTypeToVisibility},
                                                    ConverterParameter=ClientSecret}">
                                <TextBlock Text="Client secret" Style="{DynamicResource DG.GroupLabel}" />
                                <PasswordBox x:Name="ClientSecretBox"
                                             PasswordChanged="OnClientSecretChanged"
                                             Height="{DynamicResource DG.Size.Control}"
                                             Padding="{DynamicResource DG.Pad.Control}"
                                             FontSize="{DynamicResource DG.Type.Caption}"
                                             Foreground="{DynamicResource DG.Text1}"
                                             CaretBrush="{DynamicResource DG.Text1}"
                                             Background="{DynamicResource DG.CardSunken}"
                                             BorderBrush="{DynamicResource DG.ControlBorder}"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center" />
                                <TextBlock Style="{DynamicResource DG.Secondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,0"
                                           Text="Advanced: requires your own Entra app registration. The secret is encrypted at rest with DPAPI but is recoverable by anyone signed in as you — prefer a certificate." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16"
                                        Visibility="{Binding EditingProfile.AuthType,
                                                    Converter={StaticResource AuthTypeToVisibility},
                                                    ConverterParameter=Certificate}">
                                <TextBlock Text="Certificate thumbprint" Style="{DynamicResource DG.GroupLabel}" />
                                <ui:TextBox
                                    Text="{Binding EditingProfile.CertificateThumbprint, UpdateSourceTrigger=PropertyChanged}"
                                    FontFamily="{DynamicResource DG.Font.Mono}"
                                    Height="{DynamicResource DG.Size.Control}" />
                                <TextBlock Style="{DynamicResource DG.Secondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,0"
                                           Text="Certificate must be installed in your personal store (CurrentUser\My). Spacing and case are ignored." />
                            </StackPanel>

                            <!-- Test result. Success and failure share the slot; only the style differs. -->
                            <Border
                                Visibility="{Binding TestResult,
                                                 Converter={StaticResource NullToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource DG.AccentSoft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DG.AccentSoftBorder}" />
                                        <Setter Property="BorderThickness" Value="3,1,1,1" />
                                        <Setter Property="CornerRadius" Value="{DynamicResource DG.Radius.Panel}" />
                                        <Setter Property="Padding" Value="14,12" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestSucceeded}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource DG.WarningSoft}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource DG.WarningBorder}" />
                                                <Setter Property="Padding" Value="16,14" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" FontSize="{DynamicResource DG.Type.Icon}"
                                                   VerticalAlignment="Top">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                <Setter Property="Foreground" Value="{DynamicResource DG.Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestSucceeded}" Value="False">
                                                        <Setter Property="Symbol" Value="Warning24" />
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource DG.Warning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock Grid.Column="1" Style="{DynamicResource DG.Secondary}"
                                               Foreground="{DynamicResource DG.TextBody}"
                                               Text="{Binding TestResult}"
                                               Margin="12,0,0,0" LineHeight="18" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="EditorFooter" Grid.Row="2"
                            Style="{DynamicResource DG.CardFooter}" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{DynamicResource DG.LinkButton}"
                                    Foreground="{DynamicResource DG.Error}"
                                    Command="{Binding DeleteProfileCommand}"
                                    CommandParameter="{Binding EditingProfile}"
                                    Content="Delete connection"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />

                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Button Style="{DynamicResource DG.Button}"
                                        Command="{Binding TestConnectionCommand}"
                                        IsEnabled="{Binding IsTesting,
                                                    Converter={StaticResource InverseBoolConverter}}"
                                        Margin="0,4,10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ProgressRing IsIndeterminate="True" Width="13" Height="13"
                                                         Margin="0,0,7,0"
                                                         Visibility="{Binding IsTesting,
                                                                      Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="Test connection" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{DynamicResource DG.Button}"
                                        Command="{Binding CancelEditCommand}"
                                        Content="Cancel" Margin="0,4,10,4" />

                                <!-- Save and Connect are mutually exclusive: Save while unsaved/dirty,
                                     Connect once saved and clean — never both at once. -->
                                <Button Style="{DynamicResource DG.PrimaryButton}"
                                        Command="{Binding SaveProfileCommand}"
                                        Content="Save"
                                        Margin="0,4,0,4"
                                        Visibility="{Binding ShowSaveButton,
                                                     Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Button Style="{DynamicResource DG.PrimaryButton}"
                                        Command="{Binding ConnectCommand}"
                                        Content="Connect"
                                        Margin="0,4,0,4"
                                        Visibility="{Binding ShowConnectButton,
                                                     Converter={StaticResource BoolToVisibilityConverter}}" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Auto-dismissing confirmation after a successful Connect (any auth type — one code
             path handles interactive OAuth and secret/cert alike). -->
        <Border Grid.RowSpan="3" Style="{DynamicResource DG.Scrim.Style}" Focusable="False"
                Visibility="{Binding ShowConnectedToast,
                             Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{DynamicResource DG.Sheet}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="{DynamicResource DG.Type.IconLg}"
                                   Foreground="{DynamicResource DG.Success}" VerticalAlignment="Center" />
                    <TextBlock Text="Connection Successful" Style="{DynamicResource DG.CardTitle}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>