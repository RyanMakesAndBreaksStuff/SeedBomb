<!--
    Settings — restyle pass over the existing page. Structure and every binding are unchanged
    (PaletteId, DarkTheme, DefaultRecordCount, DefaultBatchSize, DefaultDop,
    SaveCommand); this only moves it onto 1a's vocabulary.

    Changes: page header added to match the other destinations; leftover type sizes and
    Opacity 0.6 replaced with DG type styles; field labels use DG.GroupLabel; CardExpander
    swapped for plain DG.CardBorder sections (there are only three, so accordions cost a click
    for nothing); palette picker promoted from a combo to a swatch row; Save moved into the
    footer bar the other pages use.
-->
<Page x:Class="SeedBomb.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:SeedBomb.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
      mc:Ignorable="d"
      VerticalAlignment="Stretch"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource DG.Surface1}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,22,32,0">
            <TextBlock Style="{DynamicResource DG.PageTitle}" Text="Settings" />
            <TextBlock Style="{DynamicResource DG.PageSubtitle}"
                       Text="Appearance and the defaults new runs start from" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,20,0,0">
            <StackPanel Margin="32,0,32,24" MaxWidth="860" HorizontalAlignment="Stretch">

                <!-- ── Appearance ────────────────────────────────────── -->
                <Border Style="{DynamicResource DG.CardBorder}">
                    <StackPanel Margin="20,18">
                        <TextBlock Style="{DynamicResource DG.CardTitle}" Text="Appearance" />

                        <TextBlock Style="{DynamicResource DG.GroupLabel}"
                                   Text="Color palette" Margin="0,16,0,8" />

                        <!--
                            Four palettes now, so they fit as a swatch row. Each tile shows the
                            light and dark accent side by side — the pair is the actual choice,
                            and a dropdown hid it behind a click.
                        -->
                        <ItemsControl ItemsSource="{Binding AvailablePalettes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="Palette"
                                                 Margin="0,0,10,0"
                                                 Cursor="Hand"
                                                 Command="{Binding DataContext.SelectPaletteCommand,
                                                           RelativeSource={RelativeSource AncestorType=Page}}"
                                                 CommandParameter="{Binding Id}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Converter="{StaticResource EqualityToBoolConverter}"
                                                          Mode="OneWay">
                                                <Binding Path="Id" />
                                                <Binding Path="DataContext.PaletteId"
                                                         RelativeSource="{RelativeSource AncestorType=Page}" />
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="Bd"
                                                        Background="{DynamicResource DG.CardSunken}"
                                                        BorderBrush="{DynamicResource DG.ControlBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource DG.Radius.Panel}"
                                                        Padding="12,10">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="22" Height="22"
                                                                    CornerRadius="{DynamicResource DG.Radius.Small}"
                                                                    Background="{Binding LightSwatch}"
                                                                    BorderBrush="{DynamicResource DG.ControlBorder}"
                                                                    BorderThickness="1"
                                                                    ToolTip="Light" />
                                                            <Border Width="22" Height="22"
                                                                    CornerRadius="{DynamicResource DG.Radius.Small}"
                                                                    Background="{Binding DarkSwatch}"
                                                                    BorderBrush="{DynamicResource DG.ControlBorder}"
                                                                    BorderThickness="1"
                                                                    Margin="5,0,0,0"
                                                                    ToolTip="Dark" />
                                                        </StackPanel>
                                                        <TextBlock Style="{DynamicResource DG.Cell}"
                                                                   Text="{Binding DisplayName}"
                                                                   Margin="0,9,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource DG.ControlHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource DG.AccentSoft}" />
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{DynamicResource DG.Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selection anchor for the swatch comparison above. -->
                        <TextBlock x:Name="PaletteSelection" Text="{Binding PaletteId}"
                                   Visibility="Collapsed" />

                        <Border BorderBrush="{DynamicResource DG.Divider}" BorderThickness="0,1,0,0"
                                Margin="0,18,0,0" Padding="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Style="{DynamicResource DG.Body}" Text="Dark theme" />
                                        <TextBlock Style="{DynamicResource DG.Tertiary}"
                                                   Text="The design of record. Light is derived from the same palette."
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     IsChecked="{Binding DarkTheme, Mode=TwoWay}"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.Name="Toggle dark theme" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Generation defaults ───────────────────────────── -->
                <Border Style="{DynamicResource DG.CardBorder}" Margin="0,14,0,0">
                    <StackPanel Margin="20,18">
                        <TextBlock Style="{DynamicResource DG.CardTitle}" Text="Generation defaults" />
                        <TextBlock Style="{DynamicResource DG.Secondary}"
                                   Text="Starting values for a new run. Any run can override them."
                                   Margin="0,4,0,0" />

                        <WrapPanel Margin="0,16,0,0">
                            <StackPanel MinWidth="160" Width="220" Margin="0,0,16,8">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Record count" />
                                <ui:NumberBox Value="{Binding DefaultRecordCount, Mode=TwoWay}"
                                              Minimum="1" Maximum="100000"
                                              Height="{DynamicResource DG.Size.Control}" />
                            </StackPanel>
                            <StackPanel MinWidth="160" Width="220" Margin="0,0,16,8">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Batch size" />
                                <ui:NumberBox Value="{Binding DefaultBatchSize, Mode=TwoWay}"
                                              Minimum="1" Maximum="1000"
                                              Height="{DynamicResource DG.Size.Control}" />
                            </StackPanel>
                            <StackPanel MinWidth="160" Width="220" Margin="0,0,0,8">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Max parallelism" />
                                <ui:NumberBox Value="{Binding DefaultDop, Mode=TwoWay}"
                                              Minimum="0" PlaceholderText="auto"
                                              Height="{DynamicResource DG.Size.Control}" />
                            </StackPanel>
                        </WrapPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Style="{DynamicResource DG.Body}" Text="Keep the run sheet open" />
                                <TextBlock Style="{DynamicResource DG.Tertiary}" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Text="Stay on the run sheet when a run finishes instead of closing it." />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                             IsChecked="{Binding KeepRunSheetOpen, Mode=TwoWay}"
                                             AutomationProperties.Name="Keep the run sheet open" />
                        </Grid>

                        <TextBlock Style="{DynamicResource DG.Tertiary}"
                                   Text="Leave parallelism at 0 to let SeedBomb pick based on the environment's throttling response."
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Appearance saves itself on change; this commits the defaults. -->
        <Border x:Name="PageFooter" Grid.Row="2"
                Background="{DynamicResource DG.Surface2}"
                BorderBrush="{DynamicResource DG.Border}"
                BorderThickness="0,1,0,0"
                Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{DynamicResource DG.Tertiary}"
                           Text="Appearance changes apply immediately."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Content="Sign out"
                               Command="{Binding SignOutCommand}"
                               Appearance="Secondary"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <Button Style="{DynamicResource DG.PrimaryButton}"
                            Command="{Binding SaveCommand}"
                            Content="Save settings"
                            VerticalAlignment="Center" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Page>