<!--
    Generate — the paged wizard. Replaces Views/Pages/GeneratePage.xaml.

    One step visible at a time. The stepper strip is a read-only indicator; navigation happens
    through the footer's Back/Next. Nothing is written to Dataverse until Start on step 4.
    The run sheet overlays the whole page while IsRunning.

    Existing VM members reused: Steps, SelectedEntities, Seed, Locale, BatchSize,
    MaxParallelism, ReviewedRuleCount, LoadRulesCommand, GoToReviewCommand,
    ResetCommand, RunId. New: CurrentStep, CanGoNext/CanGoBack, GoNextCommand/GoBackCommand, Run.
-->
<Page x:Class="Seedbomb.Views.Pages.GeneratePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Seedbomb.ViewModels"
      xmlns:controls="clr-namespace:Seedbomb.Views.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:GenerateViewModel}"
      mc:Ignorable="d"
      VerticalAlignment="Stretch"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource DG.Surface1}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="32,22,32,0">
            <TextBlock Style="{DynamicResource DG.PageTitle}" Text="Generate"/>
            <TextBlock Style="{DynamicResource DG.PageSubtitle}"
                       Text="Create synthetic Dataverse records in bulk"/>
        </StackPanel>

        <!-- ── Stepper strip (indicator only) ────────────────────────── -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" Margin="32,22,32,0"
                      IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!--
                            Active step: accent fill. Done: success glyph. Pending: control fill.
                            Driven off StepEntry.IsActive/IsDone, which the VM already computes.
                        -->
                        <Border x:Name="Dot" Width="22" Height="22" CornerRadius="11"
                                Background="{DynamicResource DG.ControlFill}"
                                BorderBrush="{DynamicResource DG.ControlBorder}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding Glyph}"
                                       FontSize="{DynamicResource DG.Type.Micro}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DG.Text3}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="Label" Text="{Binding Label}"
                                   Style="{DynamicResource DG.Cell}"
                                   Foreground="{DynamicResource DG.Text3}"
                                   Margin="9,0,0,0"/>

                        <Border x:Name="Connector" Width="44" Height="1"
                                Background="{DynamicResource DG.Border}"
                                Margin="14,0" VerticalAlignment="Center"
                                Visibility="{Binding HasNext,
                                             Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource DG.AccentChip}"/>
                            <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource DG.AccentChipBorder}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DG.Text2}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource DG.Accent}"/>
                            <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource DG.Accent}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DG.Text1}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            ── Step body ──────────────────────────────────────────────
            One card at a time. Using a single-slot ContentControl with a step-keyed template
            selector would hide the markup from the designer, so the four steps are explicit
            children with visibility bound to CurrentStep.
        -->
        <Grid Grid.Row="2" Margin="32,20,32,0">

            <!-- Step 1 · Tables -->
            <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter},
                               ConverterParameter=0}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource DG.CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="20,18,20,0">
                            <TextBlock Style="{DynamicResource DG.CardTitle}" Text="Select tables"/>
                            <TextBlock Style="{DynamicResource DG.Secondary}"
                                       Text="Pick the tables to populate. Metadata is read live from this environment."
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <controls:EntitySelectorControl x:Name="EntitySelectorCtrl"
                                                        Grid.Row="1"
                                                        MinHeight="0"
                                                        VerticalAlignment="Stretch"
                                                        Margin="20,16,20,0"
                                                        SelectedEntitiesChanged="OnEntitiesChanged"/>

                        <Border Grid.Row="2" Style="{DynamicResource DG.CardFooter}" Padding="20,11">
                            <TextBlock Style="{DynamicResource DG.Tertiary}"
                                       Text="{Binding ViewModel.FooterLabel, ElementName=EntitySelectorCtrl}"/>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Width="{DynamicResource DG.Size.AsidePane}">
                    <Border Style="{DynamicResource DG.CardBorder}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Selected"/>
                            <ItemsControl ItemsSource="{Binding SelectedTableRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{DynamicResource DG.Body}"
                                                       Text="{Binding DisplayName}"/>
                                            <TextBlock Grid.Column="1" Style="{DynamicResource DG.Secondary}"
                                                       Text="{Binding Count, StringFormat='{}{0:N0} rows'}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{DynamicResource DG.CardFooter}" Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{DynamicResource DG.Body}"
                                               FontWeight="SemiBold" Text="Total"/>
                                    <TextBlock Grid.Column="1" Style="{DynamicResource DG.Body}"
                                               FontWeight="SemiBold"
                                               Text="{Binding PlannedTotal, StringFormat='{}{0:N0} rows'}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource DG.CardBorder}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Profile"/>
                            <TextBlock Style="{DynamicResource DG.Body}" FontWeight="SemiBold"
                                       Text="{Binding ActiveProfileName}"/>
                            <TextBlock Style="{DynamicResource DG.Secondary}"
                                       Text="{Binding ProfileSummaryLine}" Margin="0,2,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{DynamicResource DG.Button}"
                                        Command="{Binding ChangeProfileCommand}"
                                        Content="Change profile" Margin="0,0,8,0"/>
                                <Button Style="{DynamicResource DG.Button}"
                                        Command="{Binding EditRulesCommand}"
                                        Content="Edit rules"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource DG.InfoBanner}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Info24"
                                           FontSize="{DynamicResource DG.Type.Icon}"
                                           Foreground="{DynamicResource DG.Accent}"
                                           VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Style="{DynamicResource DG.Secondary}"
                                       Foreground="{DynamicResource DG.TextBody}"
                                       Text="Nothing is written until you press Start on step 4. You can leave and come back — the draft is kept."
                                       Margin="12,0,0,0" TextWrapping="Wrap" LineHeight="18"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Step 2 · Volume & rules -->
            <Border Style="{DynamicResource DG.CardBorder}"
                    Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter},
                                 ConverterParameter=1}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,18,20,0">
                        <TextBlock Style="{DynamicResource DG.CardTitle}" Text="Volume &amp; rules"/>
                        <TextBlock Style="{DynamicResource DG.Secondary}"
                                   Text="Row counts per table, and the seed that makes a run reproducible."
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="20,16,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Seed"/>
                            <ui:NumberBox Style="{DynamicResource DG.NumberBox}"
                                          Value="{Binding Seed}" Minimum="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Locale"/>
                            <Border Height="{DynamicResource DG.Size.Control}"
                                    Background="{DynamicResource DG.CardSunken}"
                                    BorderBrush="{DynamicResource DG.ControlBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource DG.Radius.Control}"
                                    Padding="11,0"
                                    ToolTip="Bogus locale is English for this version. A picker ships later.">
                                <TextBlock Text="{Binding Locale}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource DG.Type.Caption}"
                                           Foreground="{DynamicResource DG.Text2}"
                                           AutomationProperties.Name="Locale"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Batch size"/>
                            <ui:NumberBox Style="{DynamicResource DG.NumberBox}"
                                          Value="{Binding BatchSize}" Minimum="1" Maximum="1000"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Parallelism"/>
                            <ui:NumberBox Style="{DynamicResource DG.NumberBox}"
                                          Value="{Binding MaxParallelism}" Minimum="1" Maximum="16"/>
                        </StackPanel>
                    </Grid>

                    <!-- Per-table row counts + a link out to the full Rules page. -->
                    <Grid Grid.Row="2" Margin="20,18,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{DynamicResource DG.GroupLabel}"
                                       Margin="0" Text="Rows per table"/>
                            <Button Grid.Column="1" Style="{DynamicResource DG.LinkButton}"
                                    Command="{Binding EditRulesCommand}"
                                    Content="{Binding RulesLinkLabel}"/>
                        </Grid>
                        <controls:FieldOverridesControl x:Name="FieldOverridesCtrl" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Step 3 · Review -->
            <Border Style="{DynamicResource DG.CardBorder}"
                    Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter},
                                 ConverterParameter=2}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,18,20,0">
                        <TextBlock Style="{DynamicResource DG.CardTitle}" Text="Review"/>
                        <TextBlock Style="{DynamicResource DG.Secondary}"
                                   Text="Sample values produced by the current rules. Nothing has been written yet."
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Preflight problems block the Start button rather than failing mid-run. -->
                    <Border Grid.Row="1" Style="{DynamicResource DG.WarningBanner}"
                            Margin="20,16,20,0"
                            Visibility="{Binding ReviewHasErrors,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="{DynamicResource DG.Type.IconLg}"
                                           Foreground="{DynamicResource DG.Warning}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Style="{DynamicResource DG.Secondary}"
                                       Foreground="{DynamicResource DG.WarningText}"
                                       Text="{Binding ReviewErrorSummary}"
                                       Margin="14,0,0,0" LineHeight="18"/>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding ReviewPreviewRows}"
                                  Margin="20,16,20,0">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource DG.TableRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{DynamicResource DG.Cell}"
                                                   Foreground="{DynamicResource DG.Text2}"
                                                   Text="{Binding Table}"/>
                                        <TextBlock Grid.Column="1" Style="{DynamicResource DG.Cell}"
                                                   Text="{Binding DisplayName}" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="2" Style="{DynamicResource DG.Mono}"
                                                   Text="{Binding SampleLine}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Step 4 · Run -->
            <Border Style="{DynamicResource DG.CardBorder}"
                    Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter},
                                 ConverterParameter=3}">
                <Grid VerticalAlignment="Top" Margin="20,18,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{DynamicResource DG.CardTitle}" Text="Ready to run"/>
                        <TextBlock Style="{DynamicResource DG.Secondary}"
                                   Text="{Binding RunConfirmationLine}"
                                   Margin="0,4,0,0" LineHeight="19"/>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RunPlanStats}" Margin="0,18,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource DG.CardSunken}"
                                        BorderBrush="{DynamicResource DG.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource DG.Radius.Panel}"
                                        Padding="16,13" Margin="0,0,14,0">
                                    <StackPanel>
                                        <TextBlock Style="{DynamicResource DG.GroupLabel}" Margin="0"
                                                   Text="{Binding Label}"/>
                                        <TextBlock Style="{DynamicResource DG.Stat}"
                                                   Text="{Binding Value}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2" Style="{DynamicResource DG.InfoBanner}" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="{DynamicResource DG.Type.Icon}"
                                           Foreground="{DynamicResource DG.Accent}"
                                           VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Style="{DynamicResource DG.Secondary}"
                                       Foreground="{DynamicResource DG.TextBody}"
                                       Text="Records are written as they are generated. Cancelling stops further writes but does not roll back rows already committed."
                                       Margin="12,0,0,0" LineHeight="18"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer: the only navigation ───────────────────────────── -->
        <Border Grid.Row="3"
                Background="{DynamicResource DG.Surface2}"
                BorderBrush="{DynamicResource DG.Border}"
                BorderThickness="0,1,0,0"
                Padding="32,14" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{DynamicResource DG.Tertiary}"
                           Text="{Binding StepProgressLabel}" VerticalAlignment="Center"/>

                <Button Grid.Column="2" Style="{DynamicResource DG.Button}"
                        Command="{Binding ResetCommand}" Content="Reset" Margin="0,0,10,0"/>

                <Button Grid.Column="3" Style="{DynamicResource DG.Button}"
                        Command="{Binding GoBackCommand}"
                        Content="Back" Margin="0,0,10,0"/>

                <!-- Next becomes Start on the last step; the VM owns the label. -->
                <Button Grid.Column="4" Style="{DynamicResource DG.PrimaryButton}"
                        Command="{Binding GoNextCommand}"
                        Content="{Binding NextButtonLabel}"/>
            </Grid>
        </Border>

        <!-- ── Run sheet overlay ─────────────────────────────────────── -->
        <controls:RunSheet Grid.Row="0" Grid.RowSpan="4"
                           DataContext="{Binding Run}"
                           Visibility="{Binding IsSheetVisible,
                                        Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</Page>
