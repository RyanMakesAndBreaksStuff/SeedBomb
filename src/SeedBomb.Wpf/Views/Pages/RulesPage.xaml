<!--
    Rules — 3b. Full page, three panes.
    Middle pane MUST take the star column: fixed side panes starved the config pane in the mock
    and the template string bled out of its card. Sides are fixed, centre flexes.
-->
<Page x:Class="SeedBomb.Views.Pages.RulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:SeedBomb.ViewModels"
      xmlns:controls="clr-namespace:SeedBomb.Views.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:RuleEditorViewModel}"
      mc:Ignorable="d"
      VerticalAlignment="Stretch"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource DG.Surface1}">

    <Grid Margin="{DynamicResource DG.Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: breadcrumb, title, table switcher, save -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Style="{DynamicResource DG.LinkButton}"
                            Command="{Binding NavigateToProfilesCommand}"
                            Content="{Binding BreadcrumbRootLabel}" />
                    <TextBlock Style="{DynamicResource DG.Tertiary}" Text=" › " />
                    <TextBlock Style="{DynamicResource DG.Tertiary}"
                               Text="{Binding ProfileName}" />
                </StackPanel>
                <TextBlock Style="{DynamicResource DG.PageTitle}" Text="Rules" />
            </StackPanel>

            <ComboBox Grid.Column="1" Style="{DynamicResource DG.ComboBox}"
                      VerticalAlignment="Bottom" Margin="16,0,8,0"
                      MinWidth="180"
                      ItemsSource="{Binding Tables}"
                      SelectedItem="{Binding SelectedTable}"
                      DisplayMemberPath="DisplayName"
                      AutomationProperties.Name="Table" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{DynamicResource DG.Button}"
                        Margin="0,0,8,0"
                        Command="{Binding SaveProfileCommand}"
                        Content="Save profile"
                        Visibility="{Binding IsWorkingSet, Converter={StaticResource InverseBoolToVisible}}" />
                <Button Style="{DynamicResource DG.PrimaryButton}"
                        Command="{Binding SaveProfileAsCommand}"
                        Content="Save profile as" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMetadataError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:InfoBar IsOpen="True"
                        Severity="Error"
                        IsClosable="False"
                        Title="Metadata unavailable"
                        Message="{Binding MetadataError}" />
            <Button Style="{DynamicResource DG.Button}"
                    Content="Retry"
                    Command="{Binding RetryMetadataCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:RuleColumnListControl Grid.Column="0" />
            <controls:RuleOperationPane Grid.Column="2" />
            <controls:RulePreviewPane Grid.Column="4" />
        </Grid>
    </Grid>
</Page>