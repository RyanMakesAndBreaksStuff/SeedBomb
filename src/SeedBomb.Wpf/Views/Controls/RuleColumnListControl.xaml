<UserControl x:Class="SeedBomb.Views.Controls.RuleColumnListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border Style="{DynamicResource DG.CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource DG.Border}"
                    BorderThickness="0,0,0,1" Padding="12">
                <StackPanel>
                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Filter columns"
                                Icon="{ui:SymbolIcon Search24}" />
                    <ItemsControl ItemsSource="{Binding ColumnFilterModes}" Margin="0,9,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource DG.LinkButton}"
                                        Command="{Binding DataContext.SetColumnFilterModeCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,6,0">
                                    <Border Style="{DynamicResource DG.Chip}">
                                        <Border.Resources>
                                            <Style TargetType="Border" BasedOn="{StaticResource DG.Chip}" />
                                        </Border.Resources>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="{DynamicResource DG.Type.Micro}"
                                                   Foreground="{DynamicResource DG.Text2}"
                                                   Text="{Binding Label}" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--
                Grouped by mapping state: mapped / unmapped-required / unmapped.
                The leading dot carries the state color; the group header is DG.GroupLabel.
            -->
            <Grid Grid.Row="1">
                <TextBlock Text="No columns for this table"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DG.Secondary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ColumnsView.IsEmpty, TargetNullValue=True}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListBox ItemsSource="{Binding ColumnsView}"
                         SelectedItem="{Binding SelectedColumn}"
                         MinHeight="0"
                         Background="Transparent" BorderThickness="0" Padding="6"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <!-- Accordion: each group header toggles its rows. Expanded state lives in
                         code-behind because every ColumnsView.Refresh() regenerates the GroupItems. -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <ToggleButton x:Name="Header" IsChecked="True"
                                                                  Cursor="Hand"
                                                                  AutomationProperties.Name="{Binding Name}"
                                                                  Loaded="OnGroupHeaderLoaded"
                                                                  DataContextChanged="OnGroupHeaderDataContextChanged"
                                                                  Click="OnGroupHeaderClick">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Padding="10,8,10,4">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon x:Name="Chevron" Symbol="ChevronDown16"
                                                                                       FontSize="{DynamicResource DG.Type.Micro}"
                                                                                       Foreground="{DynamicResource DG.Text2}"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,6,0" />
                                                                        <TextBlock Style="{DynamicResource DG.GroupLabel}" Margin="0">
                                                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="False">
                                                                        <Setter TargetName="Chevron" Property="Symbol" Value="ChevronRight16" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ItemsPresenter x:Name="Items" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger SourceName="Header" Property="IsChecked" Value="False">
                                                        <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <!-- Disabled (platform-owned) rows stay visible but unselectable;
                             the tooltip is the only place DisabledReason surfaces (S3). -->
                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                            <Setter Property="ToolTip" Value="{Binding DisabledReason}" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="{DynamicResource DG.Radius.Item}">
                                            <Grid>
                                                <Border x:Name="Stripe"
                                                        Style="{DynamicResource DG.SelectionStripe}"
                                                        Margin="0,5" Visibility="Collapsed" />
                                                <ContentPresenter Margin="{DynamicResource DG.Pad.IndexRow}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource DG.ControlHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource DG.RowSelected}" />
                                                <Setter TargetName="Stripe" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StateKey}" Value="Disabled">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="●"
                                           FontSize="{DynamicResource DG.Type.Micro}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource DG.TextDisabled}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateKey}" Value="Mapped">
                                                    <Setter Property="Foreground" Value="{DynamicResource DG.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateKey}" Value="Required">
                                                    <Setter Property="Foreground" Value="{DynamicResource DG.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateKey}" Value="Unmapped">
                                                    <Setter Property="Foreground" Value="{DynamicResource DG.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateKey}" Value="Disabled">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource DG.TextDisabled}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                    <TextBlock Style="{DynamicResource DG.Cell}"
                                               FontSize="{DynamicResource DG.Type.Subtitle}"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}" />
                                    <TextBlock Style="{DynamicResource DG.Tertiary}"
                                               FontSize="{DynamicResource DG.Type.Micro}"
                                               Text="{Binding LogicalName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LogicalName}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{DynamicResource DG.Tertiary}"
                                           FontSize="{DynamicResource DG.Type.Small}"
                                           Text="{Binding TypeLabel}" Margin="9,0,4,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Border>
</UserControl>