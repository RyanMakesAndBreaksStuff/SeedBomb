<UserControl x:Class="SeedBomb.Views.Controls.FieldOverridesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:SeedBomb.Core.Contracts;assembly=SeedBomb.Core"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Width="200" Margin="6">
                    <TextBlock Text="{Binding Entity.DisplayName}"
                               Style="{DynamicResource DG.Body}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2" />
                    <ui:NumberBox Style="{DynamicResource DG.NumberBox}"
                                  Value="{Binding Count, Mode=TwoWay}"
                                  Minimum="1"
                                  Maximum="{Binding Source={x:Static core:GenerationLimits.MaxRecordCount}, Mode=OneTime}" />
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
