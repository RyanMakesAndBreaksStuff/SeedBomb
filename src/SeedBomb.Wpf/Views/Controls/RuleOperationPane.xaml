<UserControl x:Class="Seedbomb.Views.Controls.RuleOperationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Seedbomb.Views.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RuleOperationTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{DynamicResource DG.CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Stacked, not inline: the type line wrapped into the title at narrow widths. -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource DG.Border}"
                    BorderThickness="0,0,0,1" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{DynamicResource DG.CardTitle}"
                                   Text="{Binding SelectedColumn.LogicalName}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{DynamicResource DG.Mono}"
                                   Text="{Binding SelectedColumn.TypeDetail}"
                                   Margin="0,3,0,0"/>
                        <TextBlock Style="{DynamicResource DG.Secondary}"
                                   Text="Choose how SeedBomb fills this column for every generated row."
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1" Style="{DynamicResource DG.Button}"
                               Height="{DynamicResource DG.Size.ControlSmall}"
                               Width="{DynamicResource DG.Size.ControlSmall}"
                               Padding="0" ToolTip="More"
                               VerticalAlignment="Top"
                               Click="OnMoreButtonClick">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="{DynamicResource DG.Type.Icon}"/>
                        <!-- A ContextMenu only opens on right-click by default; OnMoreButtonClick
                             opens it on left-click instead, matching ProfilesPage. -->
                        <ui:Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Delete rule" Command="{Binding DeleteRuleCommand}"/>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Operation"/>
                        <ComboBox Style="{DynamicResource DG.ComboBox}"
                                  ItemsSource="{Binding AvailableOpOptions}"
                                  DisplayMemberPath="Title" SelectedValuePath="Op"
                                  SelectedValue="{Binding SelectedOp, Mode=TwoWay}"
                                  AutomationProperties.Name="Operation"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsLookupValueOperation}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <TextBlock Text="Add record GUIDs or choose existing records" TextWrapping="Wrap"/>
                        <ComboBox ItemsSource="{Binding LookupInput.Targets}"
                                  SelectedItem="{Binding LookupInput.SelectedTarget, Mode=TwoWay}">
                            <ComboBox.Style><Style TargetType="ComboBox"><Style.Triggers>
                                <DataTrigger Binding="{Binding LookupInput.Targets.Count}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers></Style></ComboBox.Style>
                        </ComboBox>
                        <TextBox Text="{Binding LookupInput.GuidText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Comma-separated record GUIDs"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add GUIDs" Command="{Binding LookupInput.AppendManualCommand}"/>
                            <Button Content="Choose records…" Command="{Binding PickLookupRecordsCommand}" Margin="8,0,0,0"/>
                            <Button Content="Clear selected" Command="{Binding LookupInput.ClearCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding LookupInput.Records}" Height="120"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate><DataTemplate><DockPanel>
                                <Button DockPanel.Dock="Right" Content="Remove" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.LookupInput.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                <TextBlock><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" · "/>
                                    <Run Text="{Binding Entity, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Id, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Manual GUIDs are checked for format and target type, not existence." TextWrapping="Wrap"/>
                    </StackPanel>

                    <ContentControl Content="{Binding}"
                                    ContentTemplateSelector="{StaticResource RuleOperationTemplateSelector}"
                                    controls:RuleOperationTemplateSelector.RefreshOn="{Binding SelectedOp}"/>

                    <ui:InfoBar IsOpen="{Binding HasMessages}"
                                Message="{Binding InfoBarMessage}"
                                Margin="0,0,0,16">
                        <ui:InfoBar.Style>
                            <Style TargetType="ui:InfoBar">
                                <Setter Property="Severity" Value="Warning"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InfoBarIsError}" Value="True">
                                        <Setter Property="Severity" Value="Error"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:InfoBar.Style>
                    </ui:InfoBar>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
