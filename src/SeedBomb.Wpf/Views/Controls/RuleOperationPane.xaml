<UserControl x:Class="SeedBomb.Views.Controls.RuleOperationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RuleOperationTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{DynamicResource DG.CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Stacked, not inline: the type line wrapped into the title at narrow widths. -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource DG.Border}"
                    BorderThickness="0,0,0,1" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{DynamicResource DG.CardTitle}"
                                   Text="{Binding SelectedColumn.LogicalName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{DynamicResource DG.Mono}"
                                   Text="{Binding SelectedColumn.TypeLabel}"
                                   Margin="0,3,0,0" />
                        <TextBlock Style="{DynamicResource DG.Secondary}"
                                   Text="Choose how SeedBomb fills this column for every generated row."
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ui:Button Grid.Column="1" Style="{DynamicResource DG.Button}"
                               Height="{DynamicResource DG.Size.ControlSmall}"
                               Width="{DynamicResource DG.Size.ControlSmall}"
                               Padding="0" ToolTip="More"
                               VerticalAlignment="Top"
                               Click="OnMoreButtonClick">
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="{DynamicResource DG.Type.Icon}" />
                        <!-- A ContextMenu only opens on right-click by default; OnMoreButtonClick
                             opens it on left-click instead, matching ProfilesPage. -->
                        <ui:Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="Delete rule" Command="{Binding DeleteRuleCommand}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Style="{DynamicResource DG.GroupLabel}"><Run Text="Operation" /><Run Text=" *" Foreground="{DynamicResource DG.Error}" /></TextBlock>
                        <ComboBox Style="{DynamicResource DG.ComboBox}"
                                  ItemsSource="{Binding AvailableOpOptions}"
                                  DisplayMemberPath="Title" SelectedValuePath="Op"
                                  SelectedValue="{Binding SelectedOp, Mode=TwoWay}"
                                  AutomationProperties.Name="Operation" />
                    </StackPanel>

                    <StackPanel x:Name="LookupValueBlock" Margin="0,0,0,16">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLookupValueOperation}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{DynamicResource DG.GroupLabel}"
                                   Text="Add record GUIDs or choose existing records"
                                   TextWrapping="Wrap" />
                        <!-- BasedOn is required: a trigger-only Style discards the implicit
                             DG.ComboBox template and falls back to WPF-UI chrome. -->
                        <ComboBox ItemsSource="{Binding LookupInput.Targets}"
                                  SelectedItem="{Binding LookupInput.SelectedTarget, Mode=TwoWay}"
                                  AutomationProperties.Name="Lookup target table"
                                  Margin="0,0,0,8">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource DG.ComboBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LookupInput.Targets.Count}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBox Style="{DynamicResource DG.TextBox}"
                                 Text="{Binding LookupInput.GuidText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Comma-separated record GUIDs" />
                        <!-- Wraps so "Clear selected" drops to a new line instead of clipping in a narrow pane. -->
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{DynamicResource DG.Button}"
                                    Content="Add GUIDs" Command="{Binding LookupInput.AppendManualCommand}"
                                    Margin="0,0,8,8" />
                            <Button Style="{DynamicResource DG.Button}"
                                    Content="Choose records…" Command="{Binding PickLookupRecordsCommand}"
                                    Margin="0,0,8,8" />
                            <Button Style="{DynamicResource DG.Button}"
                                    Content="Clear selected" Command="{Binding LookupInput.ClearCommand}"
                                    Margin="0,0,8,8" />
                        </WrapPanel>
                        <ListBox Style="{DynamicResource DG.ListBox}"
                                 ItemsSource="{Binding LookupInput.Records}" Height="120"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource DG.LinkButton}"
                                                Content="Remove" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.LookupInput.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <TextBlock Style="{DynamicResource DG.Cell}">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " />
                                            <Run Text="{Binding Entity, Mode=OneWay}" /><Run Text=" · " />
                                            <Run Text="{Binding Id, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{DynamicResource DG.Tertiary}"
                                   Text="Manual GUIDs are checked for format and target type, not existence."
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource EmptyOpTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="constant">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ConstantOpTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="range">
                                        <Setter Property="ContentTemplate" Value="{StaticResource RangeOpTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="sequence">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SequenceOpTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="pattern">
                                        <Setter Property="ContentTemplate" Value="{StaticResource PatternOpTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="oneOf">
                                        <Setter Property="ContentTemplate" Value="{StaticResource OneOfOpTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="bogus">
                                        <Setter Property="ContentTemplate" Value="{StaticResource BogusOpTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="lookupRandom">
                                        <Setter Property="ContentTemplate"
                                                Value="{StaticResource LookupRandomOpTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <ui:InfoBar IsOpen="{Binding HasMessages}"
                                Message="{Binding InfoBarMessage}"
                                Margin="0,0,0,16">
                        <ui:InfoBar.Style>
                            <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
                                <Setter Property="Severity" Value="Warning" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InfoBarIsError}" Value="True">
                                        <Setter Property="Severity" Value="Error" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:InfoBar.Style>
                    </ui:InfoBar>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>