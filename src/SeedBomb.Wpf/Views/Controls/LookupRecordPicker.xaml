<UserControl x:Class="Seedbomb.Views.Controls.LookupRecordPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="520" MaxWidth="680" Height="480">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Target table" Style="{DynamicResource DG.GroupLabel}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource DG.ComboBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Targets.Count}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Search" Style="{DynamicResource DG.GroupLabel}" Margin="0,0,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}"
                            Style="{DynamicResource DG.Button}" Margin="8,0,0,0" />
                    <ui:TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="200" PlaceholderText="Name prefix or full GUID"
                                Icon="{ui:SymbolIcon Search24}"
                                Height="{DynamicResource DG.Size.ControlSmall}"
                                AutomationProperties.Name="Search lookup records" />
                </DockPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Selected.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Selected records" Style="{DynamicResource DG.GroupLabel}" Margin="0,0,0,4" />
            <ListBox Style="{DynamicResource DG.ListBox}" ItemsSource="{Binding Selected}" MaxHeight="96"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Remove" Style="{DynamicResource DG.LinkButton}"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{DynamicResource DG.Cell}"
                                           Text="{Binding Name, Mode=OneWay}" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Style="{DynamicResource DG.Tertiary}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Entity, Mode=OneWay}" /><Run Text=" · " />
                                    <Run Text="{Binding Id, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <ui:InfoBar Grid.Row="2" IsOpen="{Binding HasError}" Title="Lookup search failed"
                    Message="{Binding ErrorMessage}" Severity="Error"
                    IsClosable="False" Margin="0,8,0,0" />

        <ListView Grid.Row="3" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                  Background="{DynamicResource DG.CardSunken}"
                  BorderBrush="{DynamicResource DG.ControlBorder}" BorderThickness="1"
                  Foreground="{DynamicResource DG.TextBody}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="{DynamicResource DG.Pad.Row}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DG.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DG.ItemSelected}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Record" DisplayMemberBinding="{Binding Label}" Width="320" />
                    <GridViewColumn Header="Created (UTC)" DisplayMemberBinding="{Binding CreatedOn}" Width="140" />
                    <GridViewColumn Header="Created by" DisplayMemberBinding="{Binding CreatedBy}" Width="140" />
                </GridView>
            </ListView.View>
        </ListView>
        <ui:ProgressRing Grid.Row="3" IsIndeterminate="True"
                         Width="32" Height="32"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" Style="{DynamicResource DG.Secondary}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Select highlighted record" Command="{Binding AddHighlightedCommand}"
                        Style="{DynamicResource DG.Button}" />
                <Button Content="Next page" Command="{Binding NextPageCommand}"
                        Style="{DynamicResource DG.Button}" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>