<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SeedBomb</RootNamespace>
    <AssemblyName>SeedBomb</AssemblyName>
    <Product>SeedBomb</Product>
    <!-- Embeds logo.ico as the Win32 EXE resource: taskbar, Alt+Tab, and Explorer all read this. -->
    <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <StartupObject>SeedBomb.App</StartupObject>
    <AssemblyTitle>SeedBomb</AssemblyTitle>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>full</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SeedBomb.Core\SeedBomb.Core.csproj" />
    <ProjectReference Include="..\SeedBomb.Bulk\SeedBomb.Bulk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SeedBomb.Wpf.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as pack://application:,,,/Resources/<filename>. -->
    <Resource Include="Resources\logo.ico" />
    <Resource Include="Resources\logo-dark.ico" />
    <Resource Include="Resources\logo-256.png" />
    <Resource Include="Resources\logo-dark.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="SeedBomb.AppLicense.txt" />
    <EmbeddedResource Include="Resources\ThirdParty\ThirdPartyNotices.json" LogicalName="SeedBomb.ThirdPartyNotices.json" />
    <EmbeddedResource Include="Resources\ThirdParty\Licenses\*" LogicalName="SeedBomb.Licenses.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ValidateThirdPartyNoticeResources"
          BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipThirdPartyNoticeValidation)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Generate-ThirdPartyNotices.ps1&quot; -ValidateResources" />
  </Target>

</Project>
