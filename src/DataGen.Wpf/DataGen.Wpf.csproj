<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Seedbomb</RootNamespace>
    <!-- Embeds seedbomb.ico as the Win32 EXE resource: taskbar, Alt+Tab, and Explorer all read this. -->
    <ApplicationIcon>seedbomb.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <Platforms>AnyCPU;x64</Platforms>
    <StartupObject>Seedbomb.App</StartupObject>
    <AssemblyTitle>Seedbomb</AssemblyTitle>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>True</Optimize>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DataGen.Core\DataGen.Core.csproj" />
    <ProjectReference Include="..\DataGen.Bulk\DataGen.Bulk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DataGen.Wpf.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native WPF startup splash (Build Action=SplashScreen): shown by the OS-level app host
         before OnStartup runs and auto-closed on first window render. No custom code needed. -->
    <SplashScreen Include="..\..\Assets\logos\seedbomb_splash.png" />

    <!-- Embedded as pack://application:,,,/<filename> (Link flattens path). Matches MainWindow/TrayIconService. -->
    <Resource Include="..\..\Assets\logos\seedbomb.ico" Link="seedbomb.ico" />
    <Resource Include="..\..\Assets\logos\seedbomb_32x32.png" Link="seedbomb_32x32.png" />
    <Resource Include="..\..\Assets\logos\seedbomb_tray_colored.ico" Link="seedbomb_tray_colored.ico" />
    <Resource Include="..\..\Assets\logos\seedbomb_tray_white.ico" Link="seedbomb_tray_white.ico" />
  </ItemGroup>

</Project>
