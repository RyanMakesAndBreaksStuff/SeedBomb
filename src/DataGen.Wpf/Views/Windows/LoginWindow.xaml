<ui:FluentWindow x:Class="Seedbomb.Views.Windows.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Seedbomb.Views.Controls"
                 ExtendsContentIntoTitleBar="True"
                 WindowStyle="SingleBorderWindow"
                 Title="DataGen — Sign In"
                 Icon="/seedbomb.ico"
                 Width="580"
                 Height="680"
                 WindowStartupLocation="CenterScreen"
                 MinWidth="480"
                 MinHeight="560"
                 ResizeMode="CanResize">
    <Grid Background="{DynamicResource DG.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource DG.Card}"
                BorderBrush="{DynamicResource DG.Border}"
                BorderThickness="0,0,0,1">
            <ui:TitleBar Title="DataGen"
                         Height="32"
                         Background="{DynamicResource DG.Card}"
                         Foreground="{DynamicResource DG.Text2}"
                         ButtonsForeground="{DynamicResource DG.Text3}"
                         Icon="{ui:ImageIcon 'pack://application:,,,/seedbomb_32x32.png'}"
                         ShowMinimize="True"
                         ShowMaximize="True"
                         ShowClose="True" />
        </Border>

        <!-- Login card — centred in the remaining space -->
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Grid.Row="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32,28,32,32">
            <StackPanel>

                <!-- Logo icon -->
                <Border Width="48"
                        Height="48"
                        CornerRadius="12"
                    Background="{DynamicResource DG.Accent}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,18">
                    <Viewbox Width="26" Height="26"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,2 L2,7 L12,12 L22,7 Z
                                        M2,17 L12,22 L22,17
                                        M2,12 L12,17 L22,12"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- App title -->
                <TextBlock Text="DataGen"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <!-- Subtitle -->
                <TextBlock Text="Synthetic Dataverse record seeder"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

                <!-- No-profiles InfoBar -->
                <ui:InfoBar IsOpen="{Binding HasNoProfiles}"
                            Severity="Informational"
                            Message="No connection profiles found. Click 'Manage Connections' to create one."
                            IsClosable="False"
                            Margin="0,16,0,0"/>

                <!-- Sign-in button -->
                <ui:Button x:Name="SignInButton"
                           Content="{Binding SignInButtonText}"
                           HorizontalAlignment="Stretch"
                           Height="42"
                           Appearance="Primary"
                           Margin="0,24,0,0"
                           AutomationProperties.Name="Sign in with Microsoft account"
                           Click="OnSignInClick"
                           IsEnabled="{Binding HasProfiles}"/>

                <!-- Manage Connections link -->
                <ui:Button Appearance="Transparent"
                           Content="Manage Connections ›"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Command="{Binding OpenConnectionManagerCommand}"/>

                <!-- Loading indicator -->
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="28"
                                 Height="28"
                                 Margin="0,16,0,0"
                                 HorizontalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}"/>

                <!-- Error notification -->
                <ui:InfoBar IsOpen="{Binding HasError}"
                            Severity="Error"
                            Message="{Binding ErrorMessage}"
                            IsClosable="False"
                            Margin="0,12,0,0"/>

            </StackPanel>
        </Border>

        <!-- Scrim overlay (ZIndex 9) -->
        <Rectangle x:Name="DrawerScrim"
                   Grid.RowSpan="2"
                   Fill="#80000000"
                   Panel.ZIndex="9"
                   Visibility="Collapsed"
                   MouseDown="OnScrimClick"/>

        <!-- Connection Manager Drawer (ZIndex 10) -->
        <local:ConnectionManagerDrawer x:Name="DrawerControl"
                                        Grid.RowSpan="2"
                                        Panel.ZIndex="10"
                                        HorizontalAlignment="Right"
                                        Width="500"
                                        RenderTransformOrigin="0,0">
            <local:ConnectionManagerDrawer.RenderTransform>
                <TranslateTransform X="500"/>
            </local:ConnectionManagerDrawer.RenderTransform>
        </local:ConnectionManagerDrawer>

    </Grid>
</ui:FluentWindow>
