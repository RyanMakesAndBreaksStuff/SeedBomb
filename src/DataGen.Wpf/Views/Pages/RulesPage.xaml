<!--
    Rules — 3b. Full page, three panes.
    Middle pane MUST take the star column: fixed side panes starved the config pane in the mock
    and the template string bled out of its card. Sides are fixed, centre flexes.
-->
<Page x:Class="Seedbomb.Views.Pages.RulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Seedbomb.ViewModels"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:rules="clr-namespace:DataGen.Core.Rules;assembly=DataGen.Core"
      xmlns:behaviors="clr-namespace:Seedbomb.Views.Behaviors"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      d:DataContext="{d:DesignInstance Type=vm:RuleEditorViewModel}"
      mc:Ignorable="d"
      VerticalAlignment="Stretch"
      ScrollViewer.CanContentScroll="False"
      Background="{DynamicResource DG.Surface1}">

    <Page.Resources>
        <ObjectDataProvider x:Key="OneOfPickValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="rules:OneOfPick" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Page.Resources>

    <Grid Margin="{DynamicResource DG.Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: breadcrumb, title, table switcher, save -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Style="{DynamicResource DG.LinkButton}"
                            Command="{Binding NavigateToProfilesCommand}"
                            Content="{Binding BreadcrumbRootLabel}"/>
                    <TextBlock Style="{DynamicResource DG.Tertiary}" Text=" › " />
                    <TextBlock Style="{DynamicResource DG.Tertiary}"
                               Text="{Binding ProfileName}"/>
                </StackPanel>
                <TextBlock Style="{DynamicResource DG.PageTitle}" Text="Rules"/>
            </StackPanel>

            <ComboBox Grid.Column="1" Style="{DynamicResource DG.ComboBox}"
                      VerticalAlignment="Bottom" Margin="16,0,8,0"
                      MinWidth="180"
                      ItemsSource="{Binding Tables}"
                      SelectedItem="{Binding SelectedTable}"
                      DisplayMemberPath="DisplayName"
                      AutomationProperties.Name="Table"/>

            <Button Grid.Column="2" Style="{DynamicResource DG.PrimaryButton}"
                    VerticalAlignment="Bottom"
                    Command="{Binding SaveProfileCommand}"
                    Content="Save profile"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── 1. Column list ───────────────────────────────────── -->
            <Border Grid.Column="0" Style="{DynamicResource DG.CardBorder}"
                    Width="{DynamicResource DG.Size.ColumnPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource DG.Border}"
                            BorderThickness="0,0,0,1" Padding="12">
                        <StackPanel>
                            <ui:TextBox Text="{Binding ColumnFilter, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Filter columns"
                                        Height="{DynamicResource DG.Size.ControlSmall}"
                                        Icon="{ui:SymbolIcon Search24}"/>
                            <ItemsControl ItemsSource="{Binding ColumnFilterModes}" Margin="0,9,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource DG.LinkButton}"
                                                Command="{Binding DataContext.SetColumnFilterModeCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0">
                                            <Border Style="{DynamicResource DG.Chip}">
                                                <Border.Resources>
                                                    <Style TargetType="Border" BasedOn="{StaticResource DG.Chip}"/>
                                                </Border.Resources>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="{DynamicResource DG.Type.Micro}"
                                                           Foreground="{DynamicResource DG.Text2}"
                                                           Text="{Binding Label}"/>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--
                        Grouped by mapping state: mapped / unmapped-required / unmapped.
                        The leading dot carries the state color; the group header is DG.GroupLabel.
                    -->
                    <Grid Grid.Row="1">
                    <TextBlock Text="No columns for this table"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DG.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ColumnsView.IsEmpty, TargetNullValue=True}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding ColumnsView}"
                             SelectedItem="{Binding SelectedColumn}"
                             MinHeight="0"
                             Background="Transparent" BorderThickness="0" Padding="6"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{DynamicResource DG.GroupLabel}"
                                                   Text="{Binding Name}"
                                                   Margin="10,8,10,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="{DynamicResource DG.Radius.Item}">
                                                <Grid>
                                                    <Border x:Name="Stripe"
                                                            Style="{DynamicResource DG.SelectionStripe}"
                                                            Margin="0,5" Visibility="Collapsed"/>
                                                    <ContentPresenter Margin="{DynamicResource DG.Pad.IndexRow}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource DG.ControlHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource DG.RowSelected}"/>
                                                    <Setter TargetName="Stripe" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="●"
                                               FontSize="{DynamicResource DG.Type.Micro}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DG.TextDisabled}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StateKey}" Value="Mapped">
                                                        <Setter Property="Foreground" Value="{DynamicResource DG.Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateKey}" Value="Required">
                                                        <Setter Property="Foreground" Value="{DynamicResource DG.Warning}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateKey}" Value="Unmapped">
                                                        <Setter Property="Foreground" Value="{DynamicResource DG.Warning}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StateKey}" Value="Disabled">
                                                        <Setter Property="Foreground" Value="{DynamicResource DG.TextDisabled}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Style="{DynamicResource DG.Cell}"
                                               FontSize="{DynamicResource DG.Type.Subtitle}"
                                               Text="{Binding LogicalName}" Margin="9,0,0,0"/>
                                    <TextBlock Grid.Column="2" Style="{DynamicResource DG.Tertiary}"
                                               FontSize="{DynamicResource DG.Type.Small}"
                                               Text="{Binding TypeLabel}" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── 2. Operation config (primary — takes the star column) ── -->
            <Border Grid.Column="2" Style="{DynamicResource DG.CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Stacked, not inline: the type line wrapped into the title at narrow widths. -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource DG.Border}"
                            BorderThickness="0,0,0,1" Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource DG.CardTitle}"
                                       Text="{Binding SelectedColumn.LogicalName}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{DynamicResource DG.Mono}"
                                       Text="{Binding SelectedColumn.TypeDetail}"
                                       Margin="0,3,0,0"/>
                            <TextBlock Style="{DynamicResource DG.Secondary}"
                                       Text="Choose how SeedBomb fills this column for every generated row."
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Operation"/>
                                <ComboBox Style="{DynamicResource DG.ComboBox}"
                                          ItemsSource="{Binding AvailableOperations}"
                                          SelectedItem="{Binding SelectedOperation}"
                                          AutomationProperties.Name="Operation"/>
                            </StackPanel>

                            <!-- constant -->
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOp}" Value="constant">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Value"/>
                                <TextBox Style="{DynamicResource DG.TextBox}"
                                         Text="{Binding ConstantText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- range -->
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOp}" Value="range">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Min"/>
                                        <TextBox Style="{DynamicResource DG.TextBox}"
                                                 Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Max"/>
                                        <TextBox Style="{DynamicResource DG.TextBox}"
                                                 Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- sequence -->
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOp}" Value="sequence">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Start"/>
                                        <TextBox Style="{DynamicResource DG.TextBox}"
                                                 Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Step"/>
                                        <TextBox Style="{DynamicResource DG.TextBox}"
                                                 Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Template editor. overflow-wrap equivalent: TextWrapping=Wrap. -->
                            <StackPanel Margin="0,0,0,16"
                                        Visibility="{Binding IsTemplateOperation,
                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Template"/>
                                <Border Style="{DynamicResource DG.CodeBox}">
                                    <TextBox Text="{Binding TemplateExpression, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             FontFamily="{DynamicResource DG.Font.Mono}"
                                             FontSize="{DynamicResource DG.Type.Body}"
                                             Foreground="{DynamicResource DG.TextBody}"
                                             CaretBrush="{DynamicResource DG.Text1}"
                                             TextWrapping="Wrap" AcceptsReturn="False"/>
                                </Border>

                                <!-- Insertable tokens -->
                                <ItemsControl ItemsSource="{Binding AvailableTokens}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{DynamicResource DG.LinkButton}"
                                                    Command="{Binding DataContext.InsertTokenCommand,
                                                              RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,6,6">
                                                <Border Background="{DynamicResource DG.ItemSelected}"
                                                        BorderBrush="{DynamicResource DG.ControlBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource DG.Radius.Control}"
                                                        Height="{DynamicResource DG.Size.Chip}"
                                                        Padding="9,0">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontFamily="{DynamicResource DG.Font.Mono}"
                                                               FontSize="{DynamicResource DG.Type.Micro}"
                                                               Foreground="{DynamicResource DG.AccentText}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="150"/>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- oneOf -->
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOp}" Value="oneOf">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Values"/>
                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}"
                                                      IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="0,2,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Style="{DynamicResource DG.TextBox}"
                                         Text="{Binding ConstantText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0"/>
                                <TextBlock Style="{DynamicResource DG.Tertiary}"
                                           Text="Or comma-separated values for non-choice columns"
                                           Margin="0,4,0,0"/>
                                <ComboBox Style="{DynamicResource DG.ComboBox}"
                                          ItemsSource="{Binding Source={StaticResource OneOfPickValues}}"
                                          SelectedItem="{Binding Pick}"
                                          HorizontalAlignment="Left"
                                          MinWidth="120"
                                          Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- bogus -->
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedOp}" Value="bogus">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock x:Name="BogusApiLabel"
                                           Style="{DynamicResource DG.GroupLabel}"
                                           Text="API"/>
                                <ComboBox x:Name="BogusApiComboBox"
                                          Style="{DynamicResource DG.ComboBox}"
                                          ItemsSource="{Binding BogusApis}"
                                          SelectedItem="{Binding SelectedBogusApi, Mode=TwoWay}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=BogusApiLabel}"
                                          AutomationProperties.Name="API"
                                          behaviors:ValidationFocusBehavior.InputTarget="Api"
                                          TabIndex="0"/>

                                <TextBlock x:Name="BogusEndpointLabel"
                                           Style="{DynamicResource DG.GroupLabel}"
                                           Text="Endpoint"
                                           Margin="0,8,0,0"/>
                                <ComboBox x:Name="BogusEndpointComboBox"
                                          Style="{DynamicResource DG.ComboBox}"
                                          ItemsSource="{Binding BogusEndpoints}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedBogusEndpoint, Mode=TwoWay}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=BogusEndpointLabel}"
                                          AutomationProperties.Name="Endpoint"
                                          behaviors:ValidationFocusBehavior.InputTarget="Endpoint"
                                          TabIndex="1"/>

                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding BogusHasNumericArgs,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="BogusMinNumberLabel"
                                                   Style="{DynamicResource DG.GroupLabel}"
                                                   Text="Minimum"/>
                                        <TextBox x:Name="BogusMinNumberTextBox"
                                                 Style="{DynamicResource DG.TextBox}"
                                                 Text="{Binding BogusMinNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=BogusMinNumberLabel}"
                                                 AutomationProperties.Name="Minimum"
                                                 behaviors:ValidationFocusBehavior.InputTarget="Minimum"
                                                 TabIndex="2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="BogusMaxNumberLabel"
                                                   Style="{DynamicResource DG.GroupLabel}"
                                                   Text="Maximum"/>
                                        <TextBox x:Name="BogusMaxNumberTextBox"
                                                 Style="{DynamicResource DG.TextBox}"
                                                 Text="{Binding BogusMaxNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=BogusMaxNumberLabel}"
                                                 AutomationProperties.Name="Maximum"
                                                 behaviors:ValidationFocusBehavior.InputTarget="Maximum"
                                                 TabIndex="3"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding BogusHasLengthArg,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock x:Name="BogusLengthLabel"
                                               Style="{DynamicResource DG.GroupLabel}"
                                               Text="Length"/>
                                    <TextBox x:Name="BogusLengthTextBox"
                                             Style="{DynamicResource DG.TextBox}"
                                             Text="{Binding BogusLengthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=BogusLengthLabel}"
                                             AutomationProperties.Name="Length"
                                             behaviors:ValidationFocusBehavior.InputTarget="Length"
                                             TabIndex="2"/>
                                </StackPanel>

                                <Grid Margin="0,8,0,0"
                                      Visibility="{Binding BogusHasDateArgs,
                                                   Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="BogusMinDateLabel"
                                                   Style="{DynamicResource DG.GroupLabel}"
                                                   Text="Minimum date"/>
                                        <ui:CalendarDatePicker x:Name="BogusMinDatePicker"
                                                               Date="{Binding BogusMinDate, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                                               AutomationProperties.LabeledBy="{Binding ElementName=BogusMinDateLabel}"
                                                               AutomationProperties.Name="Minimum date"
                                                               behaviors:ValidationFocusBehavior.InputTarget="MinimumDate"
                                                               TabIndex="2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="BogusMaxDateLabel"
                                                   Style="{DynamicResource DG.GroupLabel}"
                                                   Text="Maximum date"/>
                                        <ui:CalendarDatePicker x:Name="BogusMaxDatePicker"
                                                               Date="{Binding BogusMaxDate, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                                               AutomationProperties.LabeledBy="{Binding ElementName=BogusMaxDateLabel}"
                                                               AutomationProperties.Name="Maximum date"
                                                               behaviors:ValidationFocusBehavior.InputTarget="MaximumDate"
                                                               TabIndex="3"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <ui:InfoBar IsOpen="{Binding HasMessages}"
                                        Message="{Binding InfoBarMessage}"
                                        Margin="0,0,0,16">
                                <ui:InfoBar.Style>
                                    <Style TargetType="ui:InfoBar">
                                        <Setter Property="Severity" Value="Warning"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InfoBarIsError}" Value="True">
                                                <Setter Property="Severity" Value="Error"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:InfoBar.Style>
                            </ui:InfoBar>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="On collision"/>
                                    <ComboBox Style="{DynamicResource DG.ComboBox}"
                                              ItemsSource="{Binding CollisionStrategies}"
                                              SelectedItem="{Binding SelectedCollisionStrategy}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource DG.GroupLabel}" Text="Case"/>
                                    <ComboBox Style="{DynamicResource DG.ComboBox}"
                                              ItemsSource="{Binding CaseTransforms}"
                                              SelectedItem="{Binding SelectedCaseTransform}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:ToggleSwitch Grid.Column="0"
                                                 IsChecked="{Binding AllowBlanks}"
                                                 VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                    <TextBlock Style="{DynamicResource DG.Body}"
                                               Text="{Binding BlankRateLabel}"/>
                                    <TextBlock Style="{DynamicResource DG.Tertiary}"
                                               Text="Mimics incomplete real-world data"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Dependency note; only when the rule references another column. -->
                            <Border Style="{DynamicResource DG.InfoBanner}"
                                    Visibility="{Binding HasDependencyNote,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Info24"
                                                   FontSize="{DynamicResource DG.Type.Icon}"
                                                   Foreground="{DynamicResource DG.Accent}"
                                                   VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Style="{DynamicResource DG.Secondary}"
                                               Foreground="{DynamicResource DG.TextBody}"
                                               Text="{Binding DependencyNote}"
                                               LineHeight="18" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── 3. Live preview ──────────────────────────────────── -->
            <Border Grid.Column="4" Style="{DynamicResource DG.CardBorder}"
                    Width="{DynamicResource DG.Size.PreviewPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource DG.Border}"
                            BorderThickness="0,0,0,1" Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{DynamicResource DG.CardTitle}"
                                       FontSize="{DynamicResource DG.Type.Subtitle}"
                                       Text="Preview" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{DynamicResource DG.Button}"
                                    Height="26" Padding="10,0"
                                    Command="{Binding RerollPreviewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24"
                                                   FontSize="{DynamicResource DG.Type.Caption}"
                                                   Margin="0,0,6,0"/>
                                    <TextBlock Text="Reroll" FontSize="{DynamicResource DG.Type.Small}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PreviewRows}" Padding="10,8">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DG.Divider}"
                                        BorderThickness="0,0,0,1" Padding="8">
                                    <TextBlock Text="{Binding DisplayValue}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DG.Mono}">
                                                <Setter Property="Foreground" Value="{DynamicResource DG.Text2}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ValueKind}" Value="Blank">
                                                        <Setter Property="Foreground" Value="{DynamicResource DG.TextDisabled}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2" Style="{DynamicResource DG.CardFooter}">
                        <TextBlock Style="{DynamicResource DG.Tertiary}"
                                   Text="{Binding PreviewFooterLabel}"
                                   TextWrapping="Wrap" LineHeight="17"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
