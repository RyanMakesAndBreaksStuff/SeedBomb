<Page x:Class="Seedbomb.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24"
                    MaxWidth="800"
                    HorizontalAlignment="Left"
                    TextElement.Foreground="{DynamicResource DG.Text1}">

            <!-- Appearance section -->
            <ui:CardExpander Header="Appearance"
                             IsExpanded="True">
                <StackPanel>
                    <TextBlock Text="Color palette"
                               FontSize="12"
                               Foreground="{DynamicResource DG.Text1}"
                               Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding AvailablePalettes}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding PaletteId, Mode=TwoWay}"
                              HorizontalAlignment="Left"
                              MinWidth="220"
                              AutomationProperties.Name="Color palette">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Margin="12,0,0,0">
                                        <Border Width="14" Height="14" CornerRadius="3"
                                                Background="{Binding LightSwatch}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                ToolTip="Light" />
                                        <Border Width="14" Height="14" CornerRadius="3"
                                                Background="{Binding DarkSwatch}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Margin="4,0,0,0"
                                                ToolTip="Dark" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Dark theme"
                               FontSize="12"
                               Foreground="{DynamicResource DG.Text1}"
                               Margin="0,8,0,2" />
                    <ui:ToggleSwitch IsChecked="{Binding DarkTheme, Mode=TwoWay}"
                                     AutomationProperties.Name="Toggle dark theme" />
                    <TextBlock Text="Reduce motion"
                               FontSize="12"
                               Foreground="{DynamicResource DG.Text1}"
                               Margin="0,8,0,2" />
                    <ui:ToggleSwitch IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                                     AutomationProperties.Name="Toggle reduce motion" />
                </StackPanel>
            </ui:CardExpander>

            <!-- Generation Defaults section -->
            <ui:CardExpander Header="Generation Defaults"
                             Margin="0,12,0,0">
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Default Record Count"
                                   FontSize="12"
                                   Foreground="{DynamicResource DG.Text1}"
                                   Margin="0,0,0,2" />
                        <ui:NumberBox Value="{Binding DefaultRecordCount, Mode=TwoWay}"
                                      Minimum="1"
                                      Maximum="100000" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Default Batch Size"
                                   FontSize="12"
                                   Foreground="{DynamicResource DG.Text1}"
                                   Margin="0,0,0,2" />
                        <ui:NumberBox Value="{Binding DefaultBatchSize, Mode=TwoWay}"
                                      Minimum="1"
                                      Maximum="1000" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Default Max Parallelism"
                                   FontSize="12"
                                   Foreground="{DynamicResource DG.Text1}"
                                   Margin="0,0,0,2" />
                        <ui:NumberBox Value="{Binding DefaultDop, Mode=TwoWay}"
                                      Minimum="0"
                                      PlaceholderText="auto" />
                    </StackPanel>
                </UniformGrid>
            </ui:CardExpander>

            <!-- About section -->
            <ui:CardExpander Header="About"
                             Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Created By"
                                   Foreground="{DynamicResource DG.Text2}"
                                   Opacity="0.6"
                                   Margin="0,0,16,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="Ryan Rettinger"
                                   Foreground="{DynamicResource DG.Text1}" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Version"
                                   Foreground="{DynamicResource DG.Text2}"
                                   Opacity="0.6"
                                   Margin="0,0,16,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding AppVersion}"
                                   Foreground="{DynamicResource DG.Text1}" />
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Runtime"
                                   Foreground="{DynamicResource DG.Text2}"
                                   Opacity="0.6" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding DotnetVersion}"
                                   Foreground="{DynamicResource DG.Text1}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Save button -->
            <ui:Button Content="Save Settings"
                       Appearance="Primary"
                       Margin="0,20,0,0"
                       Command="{Binding SaveCommand}" />

        </StackPanel>
    </ScrollViewer>
</Page>
