<Page x:Class="DataGen.Desktop.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="800" HorizontalAlignment="Left">

            <!-- Connection section -->
            <ui:CardExpander Header="Connection"
                             IsExpanded="True">
                <StackPanel>
                    <TextBlock Text="Organization URL"
                               FontSize="12"
                               Margin="0,0,0,2" />
                    <ui:TextBox PlaceholderText="https://yourorg.crm.dynamics.com"
                                Text="{Binding OrgUrl, Mode=TwoWay}"
                                Margin="0,0,0,8" />
                    <TextBlock Text="Client ID (Application ID)"
                               FontSize="12"
                               Margin="0,0,0,2" />
                    <ui:TextBox x:Name="ClientIdBox"
                                PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                Text="{Binding ClientId, Mode=TwoWay}"
                                Margin="0,0,0,8" />
                    <TextBlock Text="Tenant ID"
                               FontSize="12"
                               Margin="0,0,0,2" />
                    <ui:TextBox x:Name="TenantIdBox"
                                PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                                Text="{Binding TenantId, Mode=TwoWay}"
                                Margin="0,0,0,12" />
                    <ui:Button Content="Test Connection"
                               Command="{Binding TestConnectionCommand}" />
                    <ui:InfoBar IsOpen="True"
                                Margin="0,12,0,0"
                                Message="{Binding ConnectionTestResult}"
                                Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisible}}">
                        <ui:InfoBar.Style>
                            <Style TargetType="ui:InfoBar">
                                <Setter Property="Severity" Value="Error" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestConnectionSucceeded}" Value="True">
                                        <Setter Property="Severity" Value="Success" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:InfoBar.Style>
                    </ui:InfoBar>
                </StackPanel>
            </ui:CardExpander>

            <!-- Appearance section -->
            <ui:CardExpander Header="Appearance"
                             IsExpanded="True"
                             Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Dark theme"
                               FontSize="12"
                               Margin="0,0,0,2" />
                    <ui:ToggleSwitch IsChecked="{Binding DarkTheme, Mode=TwoWay}"
                                     AutomationProperties.Name="Toggle dark theme" />
                    <TextBlock Text="Reduce motion"
                               FontSize="12"
                               Margin="0,8,0,2" />
                    <ui:ToggleSwitch IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                                     AutomationProperties.Name="Toggle reduce motion" />
                </StackPanel>
            </ui:CardExpander>

            <!-- Generation Defaults section -->
            <ui:CardExpander Header="Generation Defaults"
                             Margin="0,12,0,0">
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Default Record Count"
                                   FontSize="12"
                                   Margin="0,0,0,2" />
                        <ui:NumberBox Value="{Binding DefaultRecordCount, Mode=TwoWay}"
                                      Minimum="1"
                                      Maximum="100000" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Default Batch Size"
                                   FontSize="12"
                                   Margin="0,0,0,2" />
                        <ui:NumberBox Value="{Binding DefaultBatchSize, Mode=TwoWay}"
                                      Minimum="1"
                                      Maximum="1000" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Default Max Parallelism"
                                   FontSize="12"
                                   Margin="0,0,0,2" />
                        <ui:NumberBox Value="{Binding DefaultDop, Mode=TwoWay}"
                                      Minimum="0"
                                      PlaceholderText="auto" />
                    </StackPanel>
                </UniformGrid>
            </ui:CardExpander>

            <!-- About section -->
            <ui:CardExpander Header="About"
                             Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Version"
                                   Opacity="0.6"
                                   Margin="0,0,16,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding AppVersion}" />
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Runtime"
                                   Opacity="0.6" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DotnetVersion}" />
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Save button -->
            <ui:Button Content="Save Settings"
                       Appearance="Primary"
                       Margin="0,20,0,0"
                       Command="{Binding SaveCommand}" />

        </StackPanel>
    </ScrollViewer>
</Page>
