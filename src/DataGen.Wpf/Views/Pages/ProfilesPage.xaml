<!--
    Profiles — 3a. List + detail, deliberately not a card grid.
    Left pane fixed at DG.Size.ListPane; detail pane takes the rest.
-->
<Page x:Class="Seedbomb.Views.Pages.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Seedbomb.ViewModels"
      d:DataContext="{d:DesignInstance Type=vm:ProfilesViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{DynamicResource DG.Surface1}">

    <Grid Margin="{DynamicResource DG.Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header + page-level commands -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Style="{DynamicResource DG.PageTitle}" Text="Profiles"/>
                <TextBlock Style="{DynamicResource DG.PageSubtitle}"
                           Text="Saved sets of tables, volumes and rules you can reuse across environments"/>
            </StackPanel>

            <Button Grid.Column="1" Style="{DynamicResource DG.PrimaryButton}"
                    Command="{Binding NewProfileCommand}"
                    VerticalAlignment="Bottom" Margin="16,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,7,0"/>
                    <TextBlock Text="New profile"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{DynamicResource DG.Button}"
                    Command="{Binding ImportCommand}"
                    Content="Import…" VerticalAlignment="Bottom"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{Binding Source={StaticResource DG.Space.L}}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── List pane ─────────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{DynamicResource DG.CardBorder}"
                    Width="{DynamicResource DG.Size.ListPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource DG.Border}"
                            BorderThickness="0,0,0,1" Padding="12,12,12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Search profiles"
                                        Height="{DynamicResource DG.Size.ControlSmall}"
                                        Icon="{ui:SymbolIcon Search24}"/>
                            <Button Grid.Column="1" Style="{DynamicResource DG.Button}"
                                    Command="{Binding CycleSortCommand}"
                                    ToolTip="Sort"
                                    Width="{DynamicResource DG.Size.ControlSmall}"
                                    Height="{DynamicResource DG.Size.ControlSmall}"
                                    Padding="0" Margin="8,0,0,0">
                                <ui:SymbolIcon Symbol="ArrowSortDownLines24" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding VisibleItems}"
                             SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" BorderThickness="0"
                             Padding="6"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="{DynamicResource DG.Radius.Item}">
                                                <Grid>
                                                    <Border x:Name="Stripe"
                                                            Style="{DynamicResource DG.SelectionStripe}"
                                                            Margin="0,11" Visibility="Collapsed"/>
                                                    <ContentPresenter Margin="{DynamicResource DG.Pad.ActionRow}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource DG.ControlHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource DG.RowSelected}"/>
                                                    <Setter TargetName="Stripe" Property="Visibility"
                                                            Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="{DynamicResource DG.Type.Body}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DG.Text1}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{DynamicResource DG.Mono}"
                                                   Text="{Binding VersionLabel}"
                                                   FontSize="{DynamicResource DG.Type.Label}"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Style="{DynamicResource DG.Tertiary}"
                                               Text="{Binding SummaryLine}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Style="{DynamicResource DG.CardFooter}">
                        <TextBlock Style="{DynamicResource DG.Tertiary}" Text="{Binding CountLabel}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Detail pane ───────────────────────────────────────── -->
            <Border Grid.Column="2" Style="{DynamicResource DG.CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource DG.Border}"
                            BorderThickness="0,0,0,1" Padding="{DynamicResource DG.Pad.CardWide}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{DynamicResource DG.CardTitle}"
                                           FontSize="{DynamicResource DG.Type.SheetTitle}"
                                           Text="{Binding SelectedItem.Name}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{DynamicResource DG.Secondary}"
                                           Text="{Binding SelectedProfileDescription}"
                                           LineHeight="18" Margin="0,4,16,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{DynamicResource DG.PrimaryButton}"
                                        Height="{DynamicResource DG.Size.ControlSmall}"
                                        Command="{Binding LoadCommand}"
                                        Content="Generate…" Margin="0,0,8,0"/>
                                <Button Style="{DynamicResource DG.Button}"
                                        Height="{DynamicResource DG.Size.ControlSmall}"
                                        Command="{Binding EditRulesCommand}"
                                        Content="Edit rules" Margin="0,0,8,0"/>
                                <ui:Button Style="{DynamicResource DG.Button}"
                                           Height="{DynamicResource DG.Size.ControlSmall}"
                                           Width="{DynamicResource DG.Size.ControlSmall}"
                                           Padding="0" ToolTip="More">
                                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14"/>
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}"/>
                                            <MenuItem Header="Export…" Command="{Binding ExportCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}"/>
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tabs: Rules / Tables & volume / History -->
                    <TabControl Grid.Row="1" Grid.RowSpan="2"
                                Background="Transparent" BorderThickness="0"
                                Padding="0" Margin="0"
                                SelectedIndex="{Binding SelectedDetailTab}">
                        <TabItem Header="Rules">
                            <Grid Margin="20,4,20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header. Column widths must match the row template below. -->
                                <Border Grid.Row="0" Style="{DynamicResource DG.TableHeader}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="132"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{DynamicResource DG.TableHeaderText}" Text="Table"/>
                                        <TextBlock Grid.Column="1" Style="{DynamicResource DG.TableHeaderText}" Text="Column" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Column="2" Style="{DynamicResource DG.TableHeaderText}" Text="Operation" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!--
                                    DG.Cell is NoWrap + ellipsis on every cell. Without it the flex
                                    column starves and rows grow to 3 lines — the 3a bug.
                                -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedProfileRules}"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{DynamicResource DG.TableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88"/>
                                                        <ColumnDefinition Width="132"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{DynamicResource DG.Cell}"
                                                               Foreground="{DynamicResource DG.Text2}"
                                                               Text="{Binding Table}"/>
                                                    <TextBlock Grid.Column="1" Style="{DynamicResource DG.Cell}"
                                                               Text="{Binding Column}" Margin="12,0,0,0"/>
                                                    <TextBlock Grid.Column="2" Style="{DynamicResource DG.Cell}"
                                                               Text="{Binding OperationSummary}" Margin="12,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Tables &amp; volume">
                            <ContentControl Content="{Binding TablesAndVolumeSummary}" Margin="20,12"/>
                        </TabItem>

                        <TabItem Header="History">
                            <ContentControl Content="{Binding ProfileRunHistory}" Margin="20,12"/>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="3" Style="{DynamicResource DG.CardFooter}" Padding="20,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{DynamicResource DG.Tertiary}"
                                       Text="{Binding SelectedProfileRuleSummary}"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,18,0">
                                <TextBlock Style="{DynamicResource DG.Tertiary}" Text="Seed " />
                                <TextBlock Style="{DynamicResource DG.Mono}"
                                           Foreground="{DynamicResource DG.TextNav}"
                                           Text="{Binding SelectedProfileSeed}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Style="{DynamicResource DG.Tertiary}"
                                       Text="{Binding SelectedProfileEditedLabel}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
