<Page x:Class="Seedbomb.Views.Pages.GeneratePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Seedbomb.Views.Controls">

    <Grid Background="{DynamicResource DG.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="28,20,28,16"
                BorderBrush="{DynamicResource DG.Border}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Generate"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DG.Text1}" />
                <TextBlock Text="Create synthetic Dataverse records in bulk"
                           FontSize="11"
                           Foreground="{DynamicResource DG.Text3}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ItemsControl Grid.ColumnSpan="3"
                          ItemsSource="{Binding Steps}"
                          Style="{StaticResource StepperStyle}"
                          Margin="0,0,0,20" />

            <ScrollViewer Grid.Row="1"
                          Grid.Column="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ui:Card Padding="0">
                        <StackPanel>
                            <Border Padding="20,14"
                                    BorderBrush="{DynamicResource DG.Border}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource DG.Accent}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="1"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="01 · SELECT ENTITIES"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DG.Text1}"
                                               VerticalAlignment="Center" />
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource DG.AccentSoft}"
                                            BorderBrush="{DynamicResource DG.AccentLight}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="9,2"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SelectedEntitiesSummary}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource DG.AccentLight}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="20,16">
                                <controls:EntitySelectorControl x:Name="EntitySelectorCtrl"
                                                                SelectedEntitiesChanged="OnEntitiesChanged" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,12,0,0"
                             Padding="0"
                             Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <Border Padding="20,14"
                                    BorderBrush="{DynamicResource DG.Border}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource DG.Accent}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="2"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="02 · CONFIGURE"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DG.Text1}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="20,16">
                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="SEED"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   Margin="0,0,0,6" />
                                        <ui:NumberBox Value="{Binding Seed, Mode=TwoWay}"
                                                      Minimum="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="BATCH SIZE"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   Margin="0,0,0,6" />
                                        <ui:NumberBox Value="{Binding BatchSize, Mode=TwoWay}"
                                                      Minimum="1"
                                                      Maximum="1000" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PARALLELISM"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   Margin="0,0,0,6" />
                                        <ui:NumberBox Value="{Binding MaxParallelism, Mode=TwoWay}"
                                                      Minimum="0"
                                                      PlaceholderText="auto" />
                                    </StackPanel>
                                </UniformGrid>
                                <Border Height="1"
                                        Background="{DynamicResource DG.Border}"
                                        Margin="0,0,0,12" />
                                <controls:FieldOverridesControl x:Name="FieldOverridesCtrl" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Step 3: Field Rules (Task 9 — Mock F1/F1b/F4) -->
                    <ui:Card Margin="0,12,0,0"
                             Padding="0"
                             Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <Border Padding="20,14"
                                    BorderBrush="{DynamicResource DG.Border}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource DG.Accent}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="3"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="03 · FIELD RULES"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DG.Text1}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="20,16">
                                <controls:FieldRulesControl x:Name="FieldRulesCtrl"
                                                             Tables="{Binding SelectedEntities}"
                                                             Metadata="{Binding EntityMetadataMap}"
                                                             Seed="{Binding Seed}"
                                                             RunId="{Binding RunId}"
                                                             DefaultRecordCount="{Binding DefaultRecordCount}" />
                                <ui:Button Content="Review →"
                                           Appearance="Primary"
                                           HorizontalAlignment="Right"
                                           Margin="0,16,0,0"
                                           AutomationProperties.Name="Continue to review"
                                           Command="{Binding GoToReviewCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- Step 4: Review — hard confirm gate (Task 9 — Mock F4) -->
                    <ui:Card Margin="0,12,0,0"
                             Padding="0"
                             Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <Border Padding="20,14"
                                    BorderBrush="{DynamicResource DG.Border}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource DG.Accent}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="4"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="04 · REVIEW"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DG.Text1}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="20,16">
                                <ui:InfoBar IsOpen="True"
                                            IsClosable="False"
                                            Severity="Informational"
                                            Message="No records have been created. Generation starts only when you press Start. … Cancel discards this draft and restores your previous committed configuration."
                                            Margin="0,0,0,14" />

                                <UniformGrid Columns="4" Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="ENTITIES"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedEntitiesSummary}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DG.Text1}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="ACTIVE RULES"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding ReviewedRuleCount}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DG.Text1}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="SEED"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Seed}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DG.Text1}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="BATCH SIZE"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding BatchSize}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DG.Text1}" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Preflight messages -->
                                <ItemsControl ItemsSource="{Binding ReviewMessages}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:InfoBar IsOpen="True"
                                                        IsClosable="False"
                                                        Message="{Binding Text}"
                                                        Margin="0,0,0,6">
                                                <ui:InfoBar.Style>
                                                    <Style TargetType="ui:InfoBar">
                                                        <Setter Property="Severity" Value="Warning" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                                <Setter Property="Severity" Value="Error" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:InfoBar.Style>
                                            </ui:InfoBar>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- First-five values per active rule (RuleValueGenerator) -->
                                <TextBlock Text="Preview (rows 0-4)"
                                           FontSize="11"
                                           Foreground="{DynamicResource DG.Text3}"
                                           Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ReviewPreviewRows}" Margin="0,0,0,14">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource DG.Surface1}"
                                                    BorderBrush="{DynamicResource DG.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,7"
                                                    Margin="0,0,0,5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DG.Text1}" />
                                                    <ItemsControl ItemsSource="{Binding Values}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource DG.Text2}"
                                                                           Margin="0,0,10,0" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="▶ Start"
                                               Appearance="Primary"
                                               Height="38"
                                               MinWidth="140"
                                               AutomationProperties.Name="Start generation"
                                               Command="{Binding GenerateCommand}" />
                                    <ui:Button Content="Cancel · discard draft"
                                               Appearance="Danger"
                                               Height="38"
                                               Margin="9,0,0,0"
                                               AutomationProperties.Name="Cancel and discard draft"
                                               Command="{Binding CancelDraftCommand}" />
                                    <ui:Button Content="← Back"
                                               Height="38"
                                               Margin="9,0,0,0"
                                               AutomationProperties.Name="Back to rules"
                                               Command="{Binding BackToRulesCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,12,0,0"
                             Padding="0"
                             Visibility="{Binding HasStarted, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <Border Padding="20,14"
                                    BorderBrush="{DynamicResource DG.Border}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="{DynamicResource DG.Surface1}"
                                            BorderBrush="{DynamicResource DG.Border}"
                                            BorderThickness="1.5"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="5"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="05 · EXECUTE"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DG.Text1}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StatusLabel}"
                                               FontSize="10"
                                               Foreground="{DynamicResource DG.Text3}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="20,16">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{Binding CancelLabel}"
                                               Appearance="Danger"
                                               Height="38"
                                               AutomationProperties.Name="Abort generation"
                                               Command="{Binding AbortCommand}"
                                               Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisible}}" />
                                    <ui:ProgressRing IsIndeterminate="True"
                                                     Width="24"
                                                     Height="24"
                                                     Margin="12,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVisible}}" />
                                </StackPanel>
                                <TextBlock Text="Waiting for in-flight batches to drain..."
                                           Opacity="0.5"
                                           FontSize="11"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding IsCancelling, Converter={StaticResource BoolToVisible}}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1"
                        Grid.Column="2">
                <ui:Card Padding="0">
                    <StackPanel>
                        <Border Padding="20,14"
                                BorderBrush="{DynamicResource DG.Border}"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="{DynamicResource DG.AccentSoft}"
                                        BorderBrush="{DynamicResource DG.AccentLight}"
                                        BorderThickness="1.5"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="◎"
                                               Foreground="{DynamicResource DG.AccentLight}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Live Status"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DG.Text1}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="20,24">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasProgress, Converter={StaticResource InverseBoolToVisible}}">
                                <TextBlock Text="◎"
                                           FontSize="32"
                                           Opacity="0.25"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource DG.Text3}" />
                                <TextBlock Text="No active generation"
                                           FontSize="13"
                                           Foreground="{DynamicResource DG.Text2}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="Live progress, throughput, and entity queue will appear here."
                                           FontSize="12"
                                           Foreground="{DynamicResource DG.Text3}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Width="220"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                            <controls:ProgressMonitorControl Progress="{Binding CurrentProgress}"
                                                             Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisible}}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,16,0,0"
                         Padding="0">
                    <StackPanel>
                        <Border Padding="20,14"
                                BorderBrush="{DynamicResource DG.Border}"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="{DynamicResource DG.Success}"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="✓"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Last Run"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DG.Text1}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="20,18"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisible}}">
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <Border Background="{DynamicResource DG.Surface1}"
                                        BorderBrush="{DynamicResource DG.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,12"
                                        Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LastResult.TotalRecords, StringFormat='{}{0:N0}'}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DG.Success}" />
                                        <TextBlock Text="RECORDS"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource DG.Surface1}"
                                        BorderBrush="{DynamicResource DG.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,12"
                                        Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LastResult.Elapsed, StringFormat='{}{0:mm\\:ss}'}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DG.Text1}" />
                                        <TextBlock Text="DURATION"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource DG.Text3}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Background="{DynamicResource DG.SuccessSoft}"
                                    BorderBrush="{DynamicResource DG.SuccessBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,10">
                                <TextBlock Text="All entities succeeded"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DG.Success}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="20,28"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisible}}">
                            <TextBlock Text="No completed run yet"
                                       FontSize="13"
                                       Foreground="{DynamicResource DG.Text2}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Last-run totals and success details will appear here."
                                       FontSize="12"
                                       Foreground="{DynamicResource DG.Text3}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Width="220"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,12,0,0"
                         Visibility="{Binding HasEntities, Converter={StaticResource BoolToVisible}}">
                    <ItemsControl ItemsSource="{Binding QueuedEntities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="{Binding DotBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Entity.DisplayName}"
                                               FontSize="12"
                                               Foreground="{DynamicResource DG.Text2}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:Card>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
