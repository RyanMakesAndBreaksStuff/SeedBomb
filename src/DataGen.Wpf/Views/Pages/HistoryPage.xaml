<Page x:Class="DataGen.Desktop.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/History.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: search + actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Search by entity name…"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        MaxWidth="360"
                        HorizontalAlignment="Left" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <ui:Button Content="Export CSV"
                           Command="{Binding ExportCsvCommand}"
                           Margin="0,0,8,0" />
                <ui:Button Content="Clear All"
                           Appearance="Danger"
                           Command="{Binding ClearHistoryCommand}" />
            </StackPanel>
        </Grid>

        <!-- Empty-state message -->
        <TextBlock Grid.Row="1"
                   Text="No runs yet — generate some data first."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.5"
                   FontSize="14"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

        <!-- Run cards list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisible}}">
            <ItemsControl ItemsSource="{Binding RunsView}"
                          ItemTemplate="{StaticResource RunCardTemplate}" />
        </ScrollViewer>

    </Grid>
</Page>
