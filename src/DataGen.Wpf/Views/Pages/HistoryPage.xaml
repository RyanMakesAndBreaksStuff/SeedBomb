<Page x:Class="Seedbomb.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/History.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{DynamicResource DG.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="28,20,28,16"
                BorderBrush="{DynamicResource DG.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Run History"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DG.Text1}" />
                    <TextBlock Text="{Binding HistorySummary}"
                               FontSize="11"
                               Foreground="{DynamicResource DG.Text3}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <ui:TextBox PlaceholderText="Search runs..."
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="180"
                                Margin="0,0,8,0" />
                    <ui:Button Content="Export CSV"
                               Command="{Binding ExportCsvCommand}"
                               Padding="14,7"
                               FontSize="12"
                               Margin="0,0,8,0" />
                    <ui:Button Content="Clear All"
                               Appearance="Danger"
                               Command="{Binding ClearHistoryCommand}"
                               Padding="14,7"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,20,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Text="No runs yet — generate some data first."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.5"
                       FontSize="14"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisible}}">
                <ItemsControl ItemsSource="{Binding RunsView}"
                              ItemTemplate="{StaticResource RunCardTemplate}" />
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
