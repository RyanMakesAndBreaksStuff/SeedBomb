<ui:ContentDialog x:Class="Seedbomb.Views.Dialogs.RuleEditorDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:sys="clr-namespace:System;assembly=mscorlib"
                   xmlns:rules="clr-namespace:DataGen.Core.Rules;assembly=DataGen.Core"
                   Title="Edit rule"
                   PrimaryButtonText="Save rule"
                   CloseButtonText="Cancel"
                   IsPrimaryButtonEnabled="{Binding CanSave}"
                   DefaultButton="Primary"
                   DialogWidth="820"
                   DialogHeight="560">

    <ui:ContentDialog.Resources>
        <ObjectDataProvider x:Key="OneOfPickValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="rules:OneOfPick" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </ui:ContentDialog.Resources>

    <Grid Background="{DynamicResource DG.Bg}"
          ColumnDefinitions="280,*">

        <!-- Left: column picker -->
        <Grid Grid.Column="0"
              Margin="0,0,12,0"
              RowDefinitions="Auto,*">

            <ui:AutoSuggestBox Grid.Row="0"
                                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search columns..."
                                Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settable" Style="{StaticResource StepHeaderStyle}" />
                    <ListBox ItemsSource="{Binding SettableColumns}"
                             SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource DG.Text1}" />
                                    <TextBlock Text="{Binding TypeLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource DG.Text3}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Platform-owned"
                               Style="{StaticResource StepHeaderStyle}"
                               Margin="0,12,0,0" />
                    <ItemsControl ItemsSource="{Binding ExcludedColumns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2" IsEnabled="False" Opacity="0.6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource DG.Text1}" />
                                        <Border Background="{DynamicResource DG.AccentSoft}"
                                                BorderBrush="{DynamicResource DG.AccentLight}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="6,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TypeLabel}" Value="MultiSelect Choice">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="v2" FontSize="10" Foreground="{DynamicResource DG.AccentLight}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisabledReason}"
                                               FontSize="11"
                                               Foreground="{DynamicResource DG.Text3}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Right: op + typed parameters + validation + preview -->
        <ui:Card Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedColumn.DisplayName}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DG.Text1}"
                               Margin="0,0,0,8" />

                    <ListBox ItemsSource="{Binding AvailableOps}"
                             SelectedItem="{Binding SelectedOp, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="0,0,0,12">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource DG.Surface1}"
                                        BorderBrush="{DynamicResource DG.Border}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,4"
                                        Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource DG.Text1}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- constant -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="constant">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Value" FontSize="11" Foreground="{DynamicResource DG.Text3}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding ConstantText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- pattern -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="pattern">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Template" FontSize="11" Foreground="{DynamicResource DG.Text3}" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- range -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="range">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Min" FontSize="11" Foreground="{DynamicResource DG.Text3}" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding MinText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Max" FontSize="11" Foreground="{DynamicResource DG.Text3}" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding MaxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- sequence -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="sequence">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Start" FontSize="11" Foreground="{DynamicResource DG.Text3}" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Step" FontSize="11" Foreground="{DynamicResource DG.Text3}" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding StepText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- oneOf -->
                    <StackPanel Margin="0,0,0,12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOp}" Value="oneOf">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Values" FontSize="11" Foreground="{DynamicResource DG.Text3}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:TextBox Text="{Binding ConstantText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Or comma-separated values for non-choice columns..."
                                    Margin="0,6,0,0" />
                        <ComboBox ItemsSource="{Binding Source={StaticResource OneOfPickValues}}"
                                  SelectedItem="{Binding Pick, Mode=TwoWay}"
                                  Margin="0,6,0,0"
                                  HorizontalAlignment="Left"
                                  MinWidth="120" />
                    </StackPanel>

                    <ui:InfoBar IsOpen="{Binding HasMessages}"
                                Message="{Binding InfoBarMessage}"
                                Margin="0,0,0,12">
                        <ui:InfoBar.Style>
                            <Style TargetType="ui:InfoBar">
                                <Setter Property="Severity" Value="Warning" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InfoBarIsError}" Value="True">
                                        <Setter Property="Severity" Value="Error" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:InfoBar.Style>
                    </ui:InfoBar>

                    <TextBlock Text="Preview (rows 0-2)" FontSize="11" Foreground="{DynamicResource DG.Text3}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding PreviewValues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource DG.Text1}"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </ui:Card>
    </Grid>
</ui:ContentDialog>
