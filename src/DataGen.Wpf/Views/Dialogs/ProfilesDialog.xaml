<ui:ContentDialog x:Class="Seedbomb.Views.Dialogs.ProfilesDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   Title="Profiles"
                   PrimaryButtonText="Back to rules"
                   SecondaryButtonText=""
                   CloseButtonText="Close"
                   IsPrimaryButtonEnabled="True"
                   IsSecondaryButtonEnabled="False"
                   DialogWidth="640"
                   DialogHeight="520">

    <Grid Background="{DynamicResource DG.Bg}">
        <!-- Manager pane (Mock F5 left) -->
        <Grid Visibility="{Binding ShowManager, Converter={StaticResource BoolToVisible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DG.Text3}"
                       FontSize="12"
                       Margin="0,0,0,10"
                       Text="Saved locally in %LOCALAPPDATA%\DataGen\profiles — plain files, no secrets. Credentials stay DPAPI-encrypted exactly as today." />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource DG.Border}"
                     Background="{DynamicResource DG.Surface1}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DG.Text1}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <ui:Button Content="📂"
                                           ToolTip="Load into board"
                                           Appearance="Secondary"
                                           Padding="8,2"
                                           Margin="2,0"
                                           Command="{Binding DataContext.LoadCommand, RelativeSource={RelativeSource AncestorType=ui:ContentDialog}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Content="⤒"
                                           ToolTip="Export copy"
                                           Appearance="Secondary"
                                           Padding="8,2"
                                           Margin="2,0"
                                           Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=ui:ContentDialog}}" />
                                <ui:Button Content="⧉"
                                           ToolTip="Duplicate"
                                           Appearance="Secondary"
                                           Padding="8,2"
                                           Margin="2,0"
                                           Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ui:ContentDialog}}" />
                                <ui:Button Content="🗑"
                                           ToolTip="Delete"
                                           Appearance="Secondary"
                                           Padding="8,2"
                                           Margin="2,0"
                                           Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ui:ContentDialog}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="New profile name"
                           FontSize="11"
                           Foreground="{DynamicResource DG.Text3}"
                           Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="acme-sales-scenario" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button Content="＋ Save current as new profile"
                               Appearance="Primary"
                               Margin="0,0,8,0"
                               Command="{Binding SaveCurrentAsNewCommand}" />
                    <ui:Button Content="Import from file…"
                               Appearance="Secondary"
                               Command="{Binding ImportFromFileCommand}" />
                </StackPanel>
                <TextBlock Text="📂 Load · ⤒ Export · ⧉ Duplicate · 🗑 Delete. Loading renders the profile on the Field Rules board — no text or schema view."
                           FontSize="11"
                           Foreground="{DynamicResource DG.Text3}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
            </StackPanel>

            <ui:InfoBar Grid.Row="3"
                        IsOpen="{Binding HasStatusMessage}"
                        IsClosable="True"
                        Title=""
                        Message="{Binding StatusMessage}"
                        Margin="0,10,0,0">
                <ui:InfoBar.Style>
                    <Style TargetType="ui:InfoBar">
                        <Setter Property="Severity" Value="Informational" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Severity" Value="Error" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:InfoBar.Style>
            </ui:InfoBar>
        </Grid>

        <!-- Import summary pane (Mock F5 right) -->
        <ScrollViewer Visibility="{Binding ShowImportSummary, Converter={StaticResource BoolToVisible}}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource DG.Text3}"
                           FontSize="12"
                           Margin="0,0,0,10"
                           Text="Validated against schema v1 and this environment's live metadata. Results are applied visually — nothing here is editable text." />

                <ui:InfoBar IsOpen="{Binding HasSchemaError}"
                            IsClosable="False"
                            Severity="Error"
                            Title="✕"
                            Message="{Binding SchemaErrorMessage}"
                            Margin="0,0,0,8" />

                <ui:InfoBar IsOpen="{Binding HasImportApplied}"
                            IsClosable="False"
                            Severity="Success"
                            Title="✓"
                            Message="{Binding ImportAppliedMessage}"
                            Margin="0,0,0,8" />

                <ui:InfoBar IsOpen="{Binding HasImportAdjusted}"
                            IsClosable="False"
                            Severity="Warning"
                            Title="⚠"
                            Message="{Binding ImportAdjustedMessage}"
                            Margin="0,0,0,8" />

                <ui:InfoBar IsOpen="{Binding HasImportNotImported}"
                            IsClosable="False"
                            Severity="Error"
                            Title="✕"
                            Message="{Binding ImportNotImportedMessage}"
                            Margin="0,0,0,8" />

                <ui:InfoBar IsOpen="{Binding HasImportInfo}"
                            IsClosable="False"
                            Severity="Informational"
                            Title="ⓘ"
                            Message="{Binding ImportInfoMessage}"
                            Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="← Back to list"
                               Appearance="Secondary"
                               Margin="0,0,8,0"
                               Command="{Binding DiscardImportCommand}" />
                    <ui:Button Content="Open in board"
                               Appearance="Primary"
                               Command="{Binding OpenInBoardCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:ContentDialog>
