<UserControl x:Class="DataGen.Wpf.Views.Controls.ProgressMonitorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <StackPanel>
        <TextBlock x:Name="PhaseText"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="EntityText"
                   Opacity="0.6"
                   Margin="0,2,0,0" />
        <ProgressBar x:Name="ProgressBar"
                     Height="8"
                     Margin="0,8,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RecordsSummary"
                       Grid.Column="0"
                       FontSize="12" />
            <TextBlock x:Name="RecordsPerMin"
                       Grid.Column="1"
                       FontSize="12"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ElapsedText"
                       Grid.Column="2"
                       FontSize="12"
                       HorizontalAlignment="Right" />
        </Grid>
        <TextBlock x:Name="BatchSummary"
                   Opacity="0.5"
                   FontSize="11"
                   Margin="0,4,0,0" />
    </StackPanel>

</UserControl>
