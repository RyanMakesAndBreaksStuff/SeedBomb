<UserControl x:Class="Seedbomb.Views.Controls.ProgressMonitorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="StudioProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="5" />
            <Setter Property="Background" Value="{DynamicResource DG.Surface1}" />
            <Setter Property="Foreground" Value="{DynamicResource DG.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="PhaseText"
                   FontSize="{DynamicResource DG.Type.Caption}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource DG.Text1}" />
        <TextBlock x:Name="EntityText"
                   FontSize="{DynamicResource DG.Type.Micro}"
                   Foreground="{DynamicResource DG.Text3}"
                   Margin="0,4,0,0" />
        <ProgressBar x:Name="ProgressBar"
                     Margin="0,14,0,12"
                     Style="{StaticResource StudioProgressBarStyle}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RecordsSummary"
                       Grid.Column="0"
                       FontSize="{DynamicResource DG.Type.Caption}"
                       Foreground="{DynamicResource DG.Text2}" />
            <TextBlock x:Name="RecordsPerMin"
                       Grid.Column="1"
                       FontSize="{DynamicResource DG.Type.Caption}"
                       Foreground="{DynamicResource DG.Text2}"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="ElapsedText"
                       Grid.Column="2"
                       FontSize="{DynamicResource DG.Type.Caption}"
                       Foreground="{DynamicResource DG.Text2}"
                       HorizontalAlignment="Right" />
        </Grid>
        <TextBlock x:Name="BatchSummary"
                   Foreground="{DynamicResource DG.Text3}"
                   FontSize="{DynamicResource DG.Type.Micro}"
                   Margin="0,8,0,0" />
    </StackPanel>

</UserControl>
