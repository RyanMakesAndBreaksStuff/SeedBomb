<UserControl x:Class="Seedbomb.Views.Controls.EntitySelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             DataContext="{Binding ViewModel, RelativeSource={RelativeSource Self}}"
             Loaded="OnLoaded">

    <Grid>
        <!-- Loading spinner -->
        <ui:ProgressRing IsIndeterminate="True"
                         Width="36" Height="36"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />

        <!-- Error message + retry -->
        <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}">
            <ui:InfoBar IsOpen="True"
                        Severity="Error"
                        Message="{Binding ErrorMessage}" />
            <ui:Button Content="Retry"
                       Margin="0,8,0,0"
                       Command="{Binding LoadEntitiesCommand}" />
        </StackPanel>

        <!-- Entity list (hidden while loading) -->
        <Expander Header="Select Entities"
                  IsExpanded="True"
                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisible}}">
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search entities..."
                            Margin="12,0,12,10" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredEntities}"
                         MaxHeight="420"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding LogicalName, StringFormat=' ({0})'}"
                                               Foreground="{DynamicResource DG.Text3}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0" />
                                    <TextBlock Text=" ●"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Expander>
    </Grid>
</UserControl>
