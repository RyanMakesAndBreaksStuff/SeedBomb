<UserControl x:Class="Seedbomb.Views.Controls.FieldRulesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Table tabs (vertical), rule-count badges -->
        <ListBox x:Name="TableTabsListBox"
                 Grid.Column="0"
                 ItemsSource="{Binding TableTabs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 SelectionChanged="OnTableTabSelected"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="0,0,12,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource DG.Text1}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource DG.AccentSoft}"
                                BorderBrush="{DynamicResource DG.AccentLight}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RuleCount}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RuleCount}"
                                       FontSize="{DynamicResource DG.Type.Tiny}"
                                       Foreground="{DynamicResource DG.AccentLight}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Selected table: Add-rule action + active-rule rows / F1b empty state -->
        <StackPanel Grid.Column="1">
            <ui:Button Content="＋ Add rule"
                       Appearance="Secondary"
                       HorizontalAlignment="Left"
                       AutomationProperties.Name="Add rule"
                       Click="OnAddRuleClick"
                       Margin="0,0,0,12" />

            <!-- F1b: fully-automatic table (no active rules) -->
            <Border Background="{DynamicResource DG.Surface1}"
                    BorderBrush="{DynamicResource DG.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveRuleCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="This table is fully automatic — no rules configured. Columns without a rule keep generating the same way they always have."
                           Foreground="{DynamicResource DG.Text3}"
                           FontSize="{DynamicResource DG.Type.Caption}"
                           TextWrapping="Wrap" />
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveRuleCount}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource DG.Surface1}"
                                BorderBrush="{DynamicResource DG.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9"
                                Margin="0,0,0,6"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnRowClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DG.Text1}" />
                                        <Border Background="{DynamicResource DG.AccentSoft}"
                                                BorderBrush="{DynamicResource DG.AccentLight}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="6,1"
                                                Margin="6,0,0,0">
                                            <TextBlock Text="{Binding OpBadge}"
                                                       FontSize="{DynamicResource DG.Type.Tiny}"
                                                       Foreground="{DynamicResource DG.AccentLight}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ParameterSummary}"
                                               FontSize="{DynamicResource DG.Type.Micro}"
                                               Foreground="{DynamicResource DG.Text3}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Preview}"
                                           FontFamily="Consolas"
                                           FontSize="{DynamicResource DG.Type.Micro}"
                                           Foreground="{DynamicResource DG.Text2}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:InfoBar IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="ⓘ"
                        Message="Columns without a rule keep auto-generating exactly as before. Rules only apply once you press Start."
                        Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
