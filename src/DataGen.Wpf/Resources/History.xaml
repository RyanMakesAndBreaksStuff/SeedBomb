<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:history="clr-namespace:Seedbomb.Services.History">

    <DataTemplate x:Key="RunCardTemplate" DataType="{x:Type history:RunRecord}">
        <Border Background="{DynamicResource DG.Card}"
                BorderBrush="{DynamicResource DG.Border}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,16"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd}}"
                               FontSize="11"
                               Foreground="{DynamicResource DG.Text3}" />
                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:hh:mm tt}}"
                               FontSize="11"
                               Foreground="{DynamicResource DG.Text3}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="Run"
                               FontSize="12"
                               Foreground="{DynamicResource DG.Text2}"
                               Margin="0,0,0,5" />
                    <ItemsControl ItemsSource="{Binding EntityNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource DG.Surface1}"
                                        BorderBrush="{DynamicResource DG.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="7,1"
                                        Margin="0,0,4,4">
                                    <TextBlock Text="{Binding}"
                                               FontSize="10"
                                               Foreground="{DynamicResource DG.Text2}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalRecords, StringFormat='{}{0:N0}'}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DG.Text1}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="records"
                               FontSize="9"
                               Foreground="{DynamicResource DG.Text3}"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <TextBlock Grid.Column="3"
                           Text="{Binding Duration, StringFormat={}{0:m\\m\\ ss\\s}}"
                           FontSize="12"
                           Foreground="{DynamicResource DG.Text3}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />

                <Border Grid.Column="4"
                        CornerRadius="12"
                        Padding="9,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource DG.ErrorSoft}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource DG.ErrorBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DG.SuccessSoft}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DG.SuccessBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="10"
                               FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="x Failed" />
                                <Setter Property="Foreground" Value="{DynamicResource DG.Error}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                <Setter Property="Text" Value="Success" />
                                        <Setter Property="Foreground" Value="{DynamicResource DG.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
