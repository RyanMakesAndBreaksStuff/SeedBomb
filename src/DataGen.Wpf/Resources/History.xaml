<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:history="clr-namespace:DataGen.Wpf.Services.History">

    <!-- Success/failure colour converters inline via DataTrigger to avoid extra converter classes -->
    <DataTemplate x:Key="RunCardTemplate" DataType="{x:Type history:RunRecord}">
        <Border CornerRadius="8"
                Padding="16"
                Margin="0,0,0,8"
                BorderThickness="1.5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Succeeded}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: timestamp + entity pills -->
                <StackPanel>
                    <TextBlock Text="{Binding Timestamp, StringFormat='ddd dd MMM yyyy HH:mm'}"
                               FontSize="11"
                               Opacity="0.5" />
                    <ItemsControl ItemsSource="{Binding EntityNames}"
                                  Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4"
                                        Padding="6,2"
                                        Margin="0,0,4,4"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding}"
                                               FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Right: record count + duration + status badge -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TotalRecords, StringFormat='{}{0:N0} records'}"
                               FontWeight="Bold"
                               FontSize="18"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Duration, StringFormat='{}{0:mm}:{0:ss}'}"
                               FontSize="11"
                               Opacity="0.5"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,4" />
                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#33D32D1C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="FAILED" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                            <Setter Property="Text" Value="SUCCESS" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
