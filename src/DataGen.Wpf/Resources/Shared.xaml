<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:converters="clr-namespace:Seedbomb.Converters">

    <!-- Value converters. Dual keys: existing views + handoff views. Task 3 replaces BoolToVisibilityConverter. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible" />
    <converters:NullToVisibilityConverter x:Key="NullToVisible" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <converters:StringToVisibilityConverter x:Key="StringToVisible" />

    <!-- ==================================================================
         1. Palette — dark (design of record)
         ================================================================== -->
    <Color x:Key="DG.Dark.BgColor">#FF202020</Color>
    <SolidColorBrush x:Key="DG.Dark.Bg"            Color="#202020"/>  <!-- window + nav pane -->
    <SolidColorBrush x:Key="DG.Dark.TitleBar"      Color="#1B1B1B"/>
    <SolidColorBrush x:Key="DG.Dark.Surface1"      Color="#272727"/>  <!-- content region -->
    <SolidColorBrush x:Key="DG.Dark.Surface2"      Color="#232323"/>  <!-- command bar / footer -->
    <SolidColorBrush x:Key="DG.Dark.Card"          Color="#2B2B2B"/>
    <SolidColorBrush x:Key="DG.Dark.CardSunken"    Color="#232323"/>  <!-- inputs inside cards -->
    <SolidColorBrush x:Key="DG.Dark.CodeSurface"   Color="#1E1E1E"/>  <!-- mono / log blocks -->
    <SolidColorBrush x:Key="DG.Dark.Border"        Color="#383838"/>
    <SolidColorBrush x:Key="DG.Dark.BorderStrong"  Color="#454545"/>  <!-- dialogs / sheets -->
    <SolidColorBrush x:Key="DG.Dark.Divider"       Color="#313131"/>  <!-- inside list/table -->
    <SolidColorBrush x:Key="DG.Dark.ControlFill"   Color="#323232"/>
    <SolidColorBrush x:Key="DG.Dark.ControlBorder" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="DG.Dark.ControlHover"  Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DG.Dark.ItemSelected"  Color="#2F2F2F"/>  <!-- nav selection -->
    <SolidColorBrush x:Key="DG.Dark.RowSelected"   Color="#3A3A3A"/>  <!-- list selection -->
    <SolidColorBrush x:Key="DG.Dark.TrackFill"     Color="#3A3A3A"/>  <!-- progress track -->
    <SolidColorBrush x:Key="DG.Dark.Scrim"         Color="#9E141414"/><!-- modal overlay, 62% -->

    <SolidColorBrush x:Key="DG.Dark.Text1"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DG.Dark.TextBody"  Color="#EAEAEA"/>
    <SolidColorBrush x:Key="DG.Dark.TextNav"   Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DG.Dark.Text2"     Color="#A0A0A0"/>
    <SolidColorBrush x:Key="DG.Dark.Text3"     Color="#8A8A8A"/>
    <SolidColorBrush x:Key="DG.Dark.TextDisabled" Color="#6A6A6A"/>

    <SolidColorBrush x:Key="DG.Dark.Accent"       Color="#A79CF1"/>
    <SolidColorBrush x:Key="DG.Dark.AccentHover"  Color="#B8AFF5"/>
    <SolidColorBrush x:Key="DG.Dark.AccentPressed" Color="#8F82E4"/>
    <SolidColorBrush x:Key="DG.Dark.OnAccent"     Color="#1B1338"/>
    <SolidColorBrush x:Key="DG.Dark.AccentText"   Color="#D9D3FB"/>  <!-- accent on dark bg -->
    <SolidColorBrush x:Key="DG.Dark.AccentSoft"   Color="#2C2740"/>  <!-- info panel fill -->
    <SolidColorBrush x:Key="DG.Dark.AccentSoftBorder" Color="#4A4270"/>
    <SolidColorBrush x:Key="DG.Dark.AccentChip"   Color="#3A3358"/>
    <SolidColorBrush x:Key="DG.Dark.AccentChipBorder" Color="#544A7D"/>

    <SolidColorBrush x:Key="DG.Dark.Success"       Color="#5BB98B"/>
    <SolidColorBrush x:Key="DG.Dark.Warning"       Color="#E0A030"/>
    <SolidColorBrush x:Key="DG.Dark.WarningSoft"   Color="#332A1E"/>
    <SolidColorBrush x:Key="DG.Dark.WarningBorder" Color="#6A552E"/>
    <SolidColorBrush x:Key="DG.Dark.WarningText"   Color="#D0C8B8"/>
    <SolidColorBrush x:Key="DG.Dark.Error"         Color="#FF9C9C"/>
    <SolidColorBrush x:Key="DG.Dark.ErrorSoft"     Color="#3A2A2A"/>
    <SolidColorBrush x:Key="DG.Dark.ErrorBorder"   Color="#6A3A3A"/>

    <!-- ==================================================================
         2. Palette — light (same structure, Win11 light surfaces)
         ================================================================== -->
    <SolidColorBrush x:Key="DG.Light.Bg"            Color="#F3F3F3"/>
    <SolidColorBrush x:Key="DG.Light.TitleBar"      Color="#F9F9F9"/>
    <SolidColorBrush x:Key="DG.Light.Surface1"      Color="#FAFAFA"/>
    <SolidColorBrush x:Key="DG.Light.Surface2"      Color="#F2F2F2"/>
    <SolidColorBrush x:Key="DG.Light.Card"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DG.Light.CardSunken"    Color="#F6F6F6"/>
    <SolidColorBrush x:Key="DG.Light.CodeSurface"   Color="#F4F4F6"/>
    <SolidColorBrush x:Key="DG.Light.Border"        Color="#E1E1E1"/>
    <SolidColorBrush x:Key="DG.Light.BorderStrong"  Color="#CFCFCF"/>
    <SolidColorBrush x:Key="DG.Light.Divider"       Color="#EBEBEB"/>
    <SolidColorBrush x:Key="DG.Light.ControlFill"   Color="#FBFBFB"/>
    <SolidColorBrush x:Key="DG.Light.ControlBorder" Color="#D8D8D8"/>
    <SolidColorBrush x:Key="DG.Light.ControlHover"  Color="#F0F0F0"/>
    <SolidColorBrush x:Key="DG.Light.ItemSelected"  Color="#EDEDED"/>
    <SolidColorBrush x:Key="DG.Light.RowSelected"   Color="#E8E6F6"/>
    <SolidColorBrush x:Key="DG.Light.TrackFill"     Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DG.Light.Scrim"         Color="#66000000"/>

    <SolidColorBrush x:Key="DG.Light.Text1"        Color="#151A21"/>
    <SolidColorBrush x:Key="DG.Light.TextBody"     Color="#26292E"/>
    <SolidColorBrush x:Key="DG.Light.TextNav"      Color="#2A2D33"/>
    <SolidColorBrush x:Key="DG.Light.Text2"        Color="#5C6470"/>
    <SolidColorBrush x:Key="DG.Light.Text3"        Color="#7A828C"/>
    <SolidColorBrush x:Key="DG.Light.TextDisabled" Color="#A6ADB6"/>

    <SolidColorBrush x:Key="DG.Light.Accent"        Color="#7160E8"/>
    <SolidColorBrush x:Key="DG.Light.AccentHover"   Color="#8574EE"/>
    <SolidColorBrush x:Key="DG.Light.AccentPressed" Color="#5B4ACF"/>
    <SolidColorBrush x:Key="DG.Light.OnAccent"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DG.Light.AccentText"    Color="#5A49C9"/>
    <SolidColorBrush x:Key="DG.Light.AccentSoft"    Color="#F1EFFD"/>
    <SolidColorBrush x:Key="DG.Light.AccentSoftBorder" Color="#D6CFFA"/>
    <SolidColorBrush x:Key="DG.Light.AccentChip"    Color="#EDEAFC"/>
    <SolidColorBrush x:Key="DG.Light.AccentChipBorder" Color="#CFC6F7"/>

    <SolidColorBrush x:Key="DG.Light.Success"       Color="#1F7A4D"/>
    <SolidColorBrush x:Key="DG.Light.Warning"       Color="#8A5A00"/>
    <SolidColorBrush x:Key="DG.Light.WarningSoft"   Color="#FFF6E5"/>
    <SolidColorBrush x:Key="DG.Light.WarningBorder" Color="#EBD5A8"/>
    <SolidColorBrush x:Key="DG.Light.WarningText"   Color="#6B5426"/>
    <SolidColorBrush x:Key="DG.Light.Error"         Color="#B02020"/>
    <SolidColorBrush x:Key="DG.Light.ErrorSoft"     Color="#FDF1F1"/>
    <SolidColorBrush x:Key="DG.Light.ErrorBorder"   Color="#EFC4C4"/>

    <!-- ==================================================================
         3. Current tokens — the ONLY keys views bind to.
            Seeded dark; DesignThemeManager reassigns from the blocks above.
         ================================================================== -->
    <SolidColorBrush x:Key="DG.Bg"            Color="#202020"/>
    <SolidColorBrush x:Key="DG.TitleBar"      Color="#1B1B1B"/>
    <SolidColorBrush x:Key="DG.Surface1"      Color="#272727"/>
    <SolidColorBrush x:Key="DG.Surface2"      Color="#232323"/>
    <SolidColorBrush x:Key="DG.Card"          Color="#2B2B2B"/>
    <SolidColorBrush x:Key="DG.CardSunken"    Color="#232323"/>
    <SolidColorBrush x:Key="DG.CodeSurface"   Color="#1E1E1E"/>
    <SolidColorBrush x:Key="DG.Border"        Color="#383838"/>
    <SolidColorBrush x:Key="DG.BorderStrong"  Color="#454545"/>
    <SolidColorBrush x:Key="DG.Divider"       Color="#313131"/>
    <SolidColorBrush x:Key="DG.ControlFill"   Color="#323232"/>
    <SolidColorBrush x:Key="DG.ControlBorder" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="DG.ControlHover"  Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DG.ItemSelected"  Color="#2F2F2F"/>
    <SolidColorBrush x:Key="DG.RowSelected"   Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DG.TrackFill"     Color="#3A3A3A"/>
    <SolidColorBrush x:Key="DG.Scrim"         Color="#9E141414"/>

    <SolidColorBrush x:Key="DG.Text1"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DG.TextBody"      Color="#EAEAEA"/>
    <SolidColorBrush x:Key="DG.TextNav"       Color="#E0E0E0"/>
    <SolidColorBrush x:Key="DG.Text2"         Color="#A0A0A0"/>
    <SolidColorBrush x:Key="DG.Text3"         Color="#8A8A8A"/>
    <SolidColorBrush x:Key="DG.TextDisabled"  Color="#6A6A6A"/>

    <SolidColorBrush x:Key="DG.Accent"            Color="#A79CF1"/>
    <SolidColorBrush x:Key="DG.AccentHover"       Color="#B8AFF5"/>
    <SolidColorBrush x:Key="DG.AccentPressed"     Color="#8F82E4"/>
    <SolidColorBrush x:Key="DG.OnAccent"          Color="#1B1338"/>
    <SolidColorBrush x:Key="DG.AccentText"        Color="#D9D3FB"/>
    <SolidColorBrush x:Key="DG.AccentSoft"        Color="#2C2740"/>
    <SolidColorBrush x:Key="DG.AccentSoftBorder"  Color="#4A4270"/>
    <SolidColorBrush x:Key="DG.AccentChip"        Color="#3A3358"/>
    <SolidColorBrush x:Key="DG.AccentChipBorder"  Color="#544A7D"/>

    <SolidColorBrush x:Key="DG.Success"       Color="#5BB98B"/>
    <SolidColorBrush x:Key="DG.Warning"       Color="#E0A030"/>
    <SolidColorBrush x:Key="DG.WarningSoft"   Color="#332A1E"/>
    <SolidColorBrush x:Key="DG.WarningBorder" Color="#6A552E"/>
    <SolidColorBrush x:Key="DG.WarningText"   Color="#D0C8B8"/>
    <SolidColorBrush x:Key="DG.Error"         Color="#FF9C9C"/>
    <SolidColorBrush x:Key="DG.ErrorSoft"     Color="#3A2A2A"/>
    <SolidColorBrush x:Key="DG.ErrorBorder"   Color="#6A3A3A"/>

    <SolidColorBrush x:Key="DG.SuccessSoft"   Color="#1F2A24"/>
    <SolidColorBrush x:Key="DG.SuccessBorder" Color="#335BB98B"/>
    <SolidColorBrush x:Key="DG.Info"          Color="#8FB6E2"/>
    <SolidColorBrush x:Key="DG.InfoSoft"      Color="#268FB6E2"/>
    <SolidColorBrush x:Key="DG.InfoBorder"    Color="#598FB6E2"/>
    <SolidColorBrush x:Key="DG.AccentLight"   Color="#B8AFF5"/>

    <!-- Legacy key kept for existing references. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#A79CF1"/>

    <!-- ==================================================================
         4. Geometry — radii, spacing scale, fixed pane widths
         ================================================================== -->
    <CornerRadius x:Key="DG.Radius.Window">8</CornerRadius>
    <CornerRadius x:Key="DG.Radius.Sheet">9</CornerRadius>
    <CornerRadius x:Key="DG.Radius.Card">7</CornerRadius>
    <CornerRadius x:Key="DG.Radius.Panel">6</CornerRadius>
    <CornerRadius x:Key="DG.Radius.Item">5</CornerRadius>
    <CornerRadius x:Key="DG.Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="DG.Radius.Small">3</CornerRadius>
    <CornerRadius x:Key="DG.Radius.Pill">12</CornerRadius>

    <!-- 4pt-based scale. Use these, not literals. -->
    <sys:Double x:Key="DG.Space.XS">4</sys:Double>
    <sys:Double x:Key="DG.Space.S">8</sys:Double>
    <sys:Double x:Key="DG.Space.M">12</sys:Double>
    <sys:Double x:Key="DG.Space.L">16</sys:Double>
    <sys:Double x:Key="DG.Space.XL">20</sys:Double>
    <sys:Double x:Key="DG.Space.XXL">32</sys:Double>

    <Thickness x:Key="DG.Pad.Card">18,16</Thickness>
    <Thickness x:Key="DG.Pad.CardWide">20,18</Thickness>
    <Thickness x:Key="DG.Pad.Page">32,22,32,24</Thickness>
    <Thickness x:Key="DG.Pad.Control">11,0</Thickness>
    <!--
         Row padding is per element CLASS, not one value and not a user setting.
         Action rows are pointer targets and never long, so they stay at Win11 default.
         Data and index rows are things users read in bulk, so they tighten.

         DG.Pad.ActionRow   ~34px  nav items, profile list, connection list
         DG.Pad.Row         ~28px  rules table, rejected-row groups (single-line cells)
         DG.Pad.IndexRow    ~26px  3b column list — keyboard-driven filter list
         DG.Pad.RowTall     ~44px  rows with a second explanatory line (3d causes)
    -->
    <Thickness x:Key="DG.Pad.ActionRow">11,10</Thickness>
    <Thickness x:Key="DG.Pad.Row">10,6</Thickness>
    <Thickness x:Key="DG.Pad.IndexRow">10,5</Thickness>
    <Thickness x:Key="DG.Pad.RowTall">10,9</Thickness>
    <Thickness x:Key="DG.Pad.ListItem">11,10</Thickness>

    <!-- Structural widths/heights taken from the mocks. -->
    <sys:Double x:Key="DG.Size.NavPane">260</sys:Double>
    <sys:Double x:Key="DG.Size.TitleBar">40</sys:Double>
    <sys:Double x:Key="DG.Size.CommandBar">60</sys:Double>
    <sys:Double x:Key="DG.Size.Control">32</sys:Double>
    <sys:Double x:Key="DG.Size.ControlSmall">30</sys:Double>
    <sys:Double x:Key="DG.Size.Chip">24</sys:Double>
    <sys:Double x:Key="DG.Size.ListPane">330</sys:Double>   <!-- 3a profile list -->
    <sys:Double x:Key="DG.Size.ColumnPane">228</sys:Double> <!-- 3b column list -->
    <sys:Double x:Key="DG.Size.PreviewPane">236</sys:Double><!-- 3b preview -->
    <sys:Double x:Key="DG.Size.AsidePane">320</sys:Double>  <!-- 2a wizard aside -->
    <sys:Double x:Key="DG.Size.SheetWidth">600</sys:Double> <!-- 3c run sheet -->
    <sys:Double x:Key="DG.Size.ProgressRing">96</sys:Double>
    <sys:Double x:Key="DG.Size.SelectionStripe">3</sys:Double>

    <!-- ==================================================================
         5. Type ramp
         ================================================================== -->
    <FontFamily x:Key="DG.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DG.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="DG.Font.Mono">Consolas, Cascadia Mono</FontFamily>

    <sys:Double x:Key="DG.Type.PageTitle">26</sys:Double>
    <sys:Double x:Key="DG.Type.SheetTitle">17</sys:Double>
    <sys:Double x:Key="DG.Type.CardTitle">15</sys:Double>
    <sys:Double x:Key="DG.Type.Subtitle">13</sys:Double>
    <sys:Double x:Key="DG.Type.Body">12.5</sys:Double>
    <sys:Double x:Key="DG.Type.Caption">12</sys:Double>
    <sys:Double x:Key="DG.Type.Small">11.5</sys:Double>
    <sys:Double x:Key="DG.Type.Micro">11</sys:Double>
    <sys:Double x:Key="DG.Type.Label">10.5</sys:Double>
    <sys:Double x:Key="DG.Type.Stat">19</sys:Double>

    <Style x:Key="DG.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DG.Font.Display}"/>
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.PageTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text1}"/>
    </Style>
    <Style x:Key="DG.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text2}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DG.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.CardTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text1}"/>
    </Style>
    <Style x:Key="DG.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.TextBody}"/>
    </Style>
    <Style x:Key="DG.Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DG.Tertiary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text3}"/>
    </Style>
    <!-- The all-caps group label used above every field group and table header. -->
    <Style x:Key="DG.GroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Micro}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text3}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="DG.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DG.Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Small}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text2}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- Numeric stat used in the run-summary tiles. -->
    <Style x:Key="DG.Stat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DG.Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Stat}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text1}"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <!-- Every table/list cell: single line, ellipsis. Prevents the row-height blowout. -->
    <Style x:Key="DG.Cell" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.TextBody}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ==================================================================
         6. Elevation
         ================================================================== -->
    <DropShadowEffect x:Key="DG.Shadow.Sheet" BlurRadius="70" ShadowDepth="24"
                      Direction="270" Opacity="0.7" Color="#000000"/>
    <DropShadowEffect x:Key="DG.Shadow.Flyout" BlurRadius="28" ShadowDepth="8"
                      Direction="270" Opacity="0.45" Color="#000000"/>

    <!-- ==================================================================
         7. Control styles — the vocabulary used across all 1a screens
         ================================================================== -->

    <!-- Card surface. Every pane in every screen is one of these. -->
    <Style x:Key="DG.CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DG.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource DG.Radius.Card}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="{x:Type ui:Card}">
        <Setter Property="Background" Value="{DynamicResource DG.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource DG.Pad.Card}"/>
    </Style>

    <Style TargetType="Page">
        <Setter Property="Background" Value="{DynamicResource DG.Bg}"/>
        <Setter Property="FontFamily" Value="{DynamicResource DG.Font}"/>
    </Style>

    <!-- Primary (accent) button — one per screen, maximum. -->
    <Style x:Key="DG.PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource DG.Size.Control}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource DG.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource DG.Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DG.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DG.AccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DG.ControlFill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DG.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard button — everything else, including Back/Next. -->
    <Style x:Key="DG.Button" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource DG.Size.Control}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.TextBody}"/>
        <Setter Property="Background" Value="{DynamicResource DG.ControlFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource DG.Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DG.ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DG.TextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Destructive button — Cancel run only. -->
    <Style x:Key="DG.DangerButton" TargetType="Button" BasedOn="{StaticResource DG.Button}">
        <Setter Property="Background" Value="{DynamicResource DG.ErrorSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.ErrorBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Error}"/>
    </Style>

    <!-- Inline link ("add a rule", "View full log"). -->
    <Style x:Key="DG.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DG.Accent}"/>
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Small}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DG.AccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text input / search field / combo face. -->
    <Style x:Key="DG.TextBox" TargetType="TextBox">
        <Setter Property="Height" Value="{DynamicResource DG.Size.Control}"/>
        <Setter Property="Padding" Value="{DynamicResource DG.Pad.Control}"/>
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text1}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource DG.Text1}"/>
        <Setter Property="Background" Value="{DynamicResource DG.CardSunken}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource DG.Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DG.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mono editor surface: template box, log block, preview rows. -->
    <Style x:Key="DG.CodeBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DG.CodeSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource DG.Radius.Control}"/>
        <Setter Property="Padding" Value="12,11"/>
    </Style>

    <!-- Filter pill. Selected variant carries the accent tint. -->
    <Style x:Key="DG.Chip" TargetType="Border">
        <Setter Property="Height" Value="{DynamicResource DG.Size.Chip}"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Background" Value="{DynamicResource DG.ItemSelected}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource DG.Radius.Pill}"/>
    </Style>
    <Style x:Key="DG.ChipSelected" TargetType="Border" BasedOn="{StaticResource DG.Chip}">
        <Setter Property="Background" Value="{DynamicResource DG.AccentChip}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.AccentChipBorder}"/>
    </Style>

    <!-- Info / warning banners. Left edge is the 3px accent stripe. -->
    <Style x:Key="DG.InfoBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DG.AccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.AccentSoftBorder}"/>
        <Setter Property="BorderThickness" Value="3,1,1,1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource DG.Radius.Panel}"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style x:Key="DG.WarningBanner" TargetType="Border" BasedOn="{StaticResource DG.InfoBanner}">
        <Setter Property="Background" Value="{DynamicResource DG.WarningSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.WarningBorder}"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <!-- Table header row and body row separators. -->
    <Style x:Key="DG.TableHeader" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource DG.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="{DynamicResource DG.Pad.Row}"/>
    </Style>
    <Style x:Key="DG.TableRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource DG.Divider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="{DynamicResource DG.Pad.Row}"/>
    </Style>
    <!-- Two-line rows: cause + hint, run + outcome. Cannot compact to DG.Pad.Row. -->
    <Style x:Key="DG.TableRowTall" TargetType="Border" BasedOn="{StaticResource DG.TableRow}">
        <Setter Property="Padding" Value="{DynamicResource DG.Pad.RowTall}"/>
    </Style>
    <Style x:Key="DG.TableHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Label}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Text3}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <!-- Card footer strip (counts, seed, "edited 2 days ago"). -->
    <Style x:Key="DG.CardFooter" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource DG.Border}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

    <!-- Progress bar: 4px, square track. -->
    <Style x:Key="DG.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource DG.TrackFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource DG.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- 3px selection stripe on the leading edge of a selected nav/list item. -->
    <Style x:Key="DG.SelectionStripe" TargetType="Border">
        <Setter Property="Width" Value="{DynamicResource DG.Size.SelectionStripe}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource DG.Accent}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,9"/>
    </Style>

    <!-- Modal scrim behind the run sheet. -->
    <Style x:Key="DG.Scrim.Style" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DG.Scrim}"/>
    </Style>
    <Style x:Key="DG.Sheet" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DG.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DG.BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource DG.Radius.Sheet}"/>
        <Setter Property="Effect" Value="{StaticResource DG.Shadow.Sheet}"/>
    </Style>

    <Style x:Key="StepHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DG.Type.Micro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DG.Text3}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ==================================================================
         8. WPF-UI overrides — keeps library chrome on our palette
         ================================================================== -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush"              Color="#202020"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"              Color="#272727"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"     Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush"   Color="#232323"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"            Color="#323232"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"          Color="#3D3D3D"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"          Color="#383838"/>
    <SolidColorBrush x:Key="NavigationViewContentBackground"         Color="#272727"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush"    Color="#2D2D2D"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"               Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"             Color="#A0A0A0"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"              Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"              Color="#6A6A6A"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush"             Color="#A79CF1"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"           Color="#B8AFF5"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"            Color="#8F82E4"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"         Color="#D9D3FB"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush"       Color="#1B1338"/>
    <SolidColorBrush x:Key="SystemAccentColorBrush"                  Color="#A79CF1"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush"           Color="#A79CF1"/>
    <SolidColorBrush x:Key="SystemAccentColor3Brush"                 Color="#3A3358"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush"             Color="#5BB98B"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBrush"             Color="#E0A030"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush"            Color="#FF9C9C"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush"   Color="#1F2A24"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush"   Color="#332A1E"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush"  Color="#3A2A2A"/>

</ResourceDictionary>
