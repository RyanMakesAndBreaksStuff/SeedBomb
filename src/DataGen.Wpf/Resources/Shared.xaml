<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:converters="clr-namespace:DataGen.Desktop.Converters">

    <!-- Value converters -->
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible" />
    <converters:NullToVisibilityConverter x:Key="NullToVisible" />
    <converters:StringToVisibilityConverter x:Key="StringToVisible" />

    <!-- ── DataGen Brand Palette ──────────────────────────────────────── -->
    <!-- Design 2 light palette from Docs/mocks/wire2.html. -->

    <!-- Dark surface hierarchy from Docs/mocks/wire2.html. -->
    <SolidColorBrush x:Key="DG.Dark.Bg"       Color="#0C0A18"/>
    <SolidColorBrush x:Key="DG.Dark.Surface1"  Color="#16122A"/>
    <SolidColorBrush x:Key="DG.Dark.Surface2"  Color="#201C3C"/>
    <SolidColorBrush x:Key="DG.Dark.Card"      Color="#1C1834"/>
    <SolidColorBrush x:Key="DG.Dark.Border"    Color="#38306A"/>
    <SolidColorBrush x:Key="DG.Dark.Text1"     Color="#EDE8FF"/>
    <SolidColorBrush x:Key="DG.Dark.Text2"     Color="#9B8EC4"/>
    <SolidColorBrush x:Key="DG.Dark.Text3"     Color="#5A5080"/>

    <!-- Light surface hierarchy -->
    <SolidColorBrush x:Key="DG.Light.Bg"       Color="#F3F0FC"/>
    <SolidColorBrush x:Key="DG.Light.Surface1"  Color="#EDE8FF"/>
    <SolidColorBrush x:Key="DG.Light.Card"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DG.Light.Border"    Color="#DDD5F5"/>
    <SolidColorBrush x:Key="DG.Light.Text1"     Color="#1A0F3C"/>
    <SolidColorBrush x:Key="DG.Light.Text2"     Color="#6B5B8A"/>
    <SolidColorBrush x:Key="DG.Light.Text3"     Color="#9E8EC4"/>

    <!-- Semantic / shared (theme-invariant) -->
    <SolidColorBrush x:Key="DG.Accent"   Color="#7C3AED"/>
    <SolidColorBrush x:Key="DG.AccentLight" Color="#9461F7"/>
    <SolidColorBrush x:Key="DG.AccentSoft" Color="#1F7C3AED"/>
    <SolidColorBrush x:Key="DG.Success"  Color="#059669"/>
    <SolidColorBrush x:Key="DG.Warning"  Color="#D97706"/>
    <SolidColorBrush x:Key="DG.Error"    Color="#DC2626"/>

    <!-- Legacy key kept for any existing references -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>

    <!-- Current design tokens. DesignThemeManager swaps these for dark mode. -->
    <SolidColorBrush x:Key="DG.Bg"       Color="#F3F0FC"/>
    <SolidColorBrush x:Key="DG.Surface1" Color="#EDE8FF"/>
    <SolidColorBrush x:Key="DG.Card"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DG.Border"   Color="#DDD5F5"/>
    <SolidColorBrush x:Key="DG.Text1"    Color="#1A0F3C"/>
    <SolidColorBrush x:Key="DG.Text2"    Color="#6B5B8A"/>
    <SolidColorBrush x:Key="DG.Text3"    Color="#9E8EC4"/>

    <!-- WPF-UI token overrides used by app chrome and common controls. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F3F0FC"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F3F0FC"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#EDE8FF"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#EDE8FF"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#DDD5F5"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#DDD5F5"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A0F3C"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6B5B8A"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#9E8EC4"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#9461F7"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#7C3AED"/>

    <Style TargetType="Page">
        <Setter Property="Background" Value="{DynamicResource DG.Bg}" />
    </Style>

    <Style TargetType="{x:Type ui:Card}">
        <Setter Property="Background" Value="{DynamicResource DG.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DG.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- Step header text style used by wizard step cards -->
    <Style x:Key="StepHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

</ResourceDictionary>
