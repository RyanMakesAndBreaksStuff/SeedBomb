<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:DataGen.Desktop.Converters">

    <!-- Value converters -->
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible" />
    <converters:NullToVisibilityConverter x:Key="NullToVisible" />
    <converters:StringToVisibilityConverter x:Key="StringToVisible" />

    <!-- ── DataGen Brand Palette ──────────────────────────────────────── -->
    <!-- Hex values that are explicitly labeled in the design spec are used verbatim.
         Unlabeled swatches (card, border, text) are derived to match the palette tone. -->

    <!-- Dark surface hierarchy -->
    <SolidColorBrush x:Key="DG.Dark.Bg"       Color="#090E1A"/>
    <SolidColorBrush x:Key="DG.Dark.Surface1"  Color="#101828"/>
    <SolidColorBrush x:Key="DG.Dark.Surface2"  Color="#172135"/>
    <SolidColorBrush x:Key="DG.Dark.Card"      Color="#1D2A3D"/>
    <SolidColorBrush x:Key="DG.Dark.Border"    Color="#253248"/>
    <SolidColorBrush x:Key="DG.Dark.Text1"     Color="#E8EEF8"/>
    <SolidColorBrush x:Key="DG.Dark.Text2"     Color="#8DA0C2"/>
    <SolidColorBrush x:Key="DG.Dark.Text3"     Color="#566B8A"/>

    <!-- Light surface hierarchy -->
    <SolidColorBrush x:Key="DG.Light.Bg"       Color="#EBF0FF"/>
    <SolidColorBrush x:Key="DG.Light.Surface1"  Color="#F4F8FF"/>
    <SolidColorBrush x:Key="DG.Light.Card"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DG.Light.Border"    Color="#C2D1F8"/>
    <SolidColorBrush x:Key="DG.Light.Text1"     Color="#0D1B35"/>
    <SolidColorBrush x:Key="DG.Light.Text2"     Color="#3A4F7A"/>
    <SolidColorBrush x:Key="DG.Light.Text3"     Color="#7A8FAD"/>

    <!-- Semantic / shared (theme-invariant) -->
    <SolidColorBrush x:Key="DG.Accent"   Color="#3D6FE8"/>
    <SolidColorBrush x:Key="DG.Success"  Color="#22C55E"/>
    <SolidColorBrush x:Key="DG.Warning"  Color="#F59E0B"/>
    <SolidColorBrush x:Key="DG.Error"    Color="#EF4444"/>

    <!-- Legacy key kept for any existing references -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3D6FE8"/>

    <!-- Step header text style used by wizard step cards -->
    <Style x:Key="StepHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

</ResourceDictionary>
