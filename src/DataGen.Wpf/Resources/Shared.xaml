<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:converters="clr-namespace:DataGen.Desktop.Converters">

    <!-- Value converters -->
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible" />
    <converters:NullToVisibilityConverter x:Key="NullToVisible" />
    <converters:StringToVisibilityConverter x:Key="StringToVisible" />

    <!-- Slate / Steel dark palette. -->
    <SolidColorBrush x:Key="DG.Dark.Bg"       Color="#101318"/>
    <SolidColorBrush x:Key="DG.Dark.Surface1" Color="#171C23"/>
    <SolidColorBrush x:Key="DG.Dark.Surface2" Color="#202733"/>
    <SolidColorBrush x:Key="DG.Dark.Card"     Color="#202733"/>
    <SolidColorBrush x:Key="DG.Dark.Border"   Color="#303A49"/>
    <SolidColorBrush x:Key="DG.Dark.Text1"    Color="#E2E7EE"/>
    <SolidColorBrush x:Key="DG.Dark.Text2"    Color="#9AA6B5"/>
    <SolidColorBrush x:Key="DG.Dark.Text3"    Color="#6F7C8E"/>

    <!-- Slate / Steel light palette. -->
    <SolidColorBrush x:Key="DG.Light.Bg"       Color="#F5F6F8"/>
    <SolidColorBrush x:Key="DG.Light.Surface1" Color="#ECEFF3"/>
    <SolidColorBrush x:Key="DG.Light.Surface2" Color="#ECEFF3"/>
    <SolidColorBrush x:Key="DG.Light.Card"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DG.Light.Border"   Color="#D3D9E1"/>
    <SolidColorBrush x:Key="DG.Light.Text1"    Color="#151A21"/>
    <SolidColorBrush x:Key="DG.Light.Text2"    Color="#606B79"/>
    <SolidColorBrush x:Key="DG.Light.Text3"    Color="#7C8794"/>

    <!-- Current design tokens. DesignThemeManager swaps these for dark mode. -->
    <SolidColorBrush x:Key="DG.Bg"       Color="#F5F6F8"/>
    <SolidColorBrush x:Key="DG.Surface1" Color="#ECEFF3"/>
    <SolidColorBrush x:Key="DG.Surface2" Color="#ECEFF3"/>
    <SolidColorBrush x:Key="DG.Card"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DG.Border"   Color="#D3D9E1"/>
    <SolidColorBrush x:Key="DG.Text1"    Color="#151A21"/>
    <SolidColorBrush x:Key="DG.Text2"    Color="#606B79"/>
    <SolidColorBrush x:Key="DG.Text3"    Color="#7C8794"/>
    <SolidColorBrush x:Key="DG.Accent"   Color="#3E6FA8"/>
    <SolidColorBrush x:Key="DG.AccentLight" Color="#668DBE"/>
    <SolidColorBrush x:Key="DG.AccentSoft" Color="#DCE8F5"/>
    <SolidColorBrush x:Key="DG.Success"  Color="#2F7D52"/>
    <SolidColorBrush x:Key="DG.Warning"  Color="#A87524"/>
    <SolidColorBrush x:Key="DG.Error"    Color="#B84A4A"/>
    <SolidColorBrush x:Key="DG.Info"     Color="#3E75A8"/>
    <SolidColorBrush x:Key="DG.SuccessSoft" Color="#1A2F7D52"/>
    <SolidColorBrush x:Key="DG.SuccessBorder" Color="#402F7D52"/>
    <SolidColorBrush x:Key="DG.WarningSoft" Color="#1AA87524"/>
    <SolidColorBrush x:Key="DG.WarningBorder" Color="#40A87524"/>
    <SolidColorBrush x:Key="DG.ErrorSoft" Color="#1AB84A4A"/>
    <SolidColorBrush x:Key="DG.ErrorBorder" Color="#40B84A4A"/>
    <SolidColorBrush x:Key="DG.InfoSoft" Color="#1A3E75A8"/>
    <SolidColorBrush x:Key="DG.InfoBorder" Color="#403E75A8"/>

    <!-- Legacy key kept for any existing references. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3E6FA8"/>

    <!-- WPF-UI token overrides used by app chrome and common controls. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#ECEFF3"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#ECEFF3"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D3D9E1"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#D3D9E1"/>
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#D3D9E1"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#151A21"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#606B79"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7C8794"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3E6FA8"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#668DBE"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#3E6FA8"/>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#3E6FA8"/>
    <SolidColorBrush x:Key="SystemAccentColor3Brush" Color="#DCE8F5"/>
    <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#1A2F7D52"/>
    <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#1AB84A4A"/>
    <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#1AA87524"/>

    <Style TargetType="Page">
        <Setter Property="Background" Value="{DynamicResource DG.Bg}" />
    </Style>

    <Style TargetType="{x:Type ui:Card}">
        <Setter Property="Background" Value="{DynamicResource DG.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DG.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- Step header text style used by wizard step cards -->
    <Style x:Key="StepHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

</ResourceDictionary>
